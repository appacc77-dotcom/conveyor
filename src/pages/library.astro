---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import LibraryHero from '../components/LibraryHero.astro';
import LibraryBook from '../components/LibraryBook.astro';
import LibraryJournal from '../components/LibraryJournal.astro';
import LibraryIssues from '../components/LibraryIssues.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Библиотека — Syntonia"
  description="Книга «Коды построения реальности» и журнал Syntonia.Life."
>
  <div class="library-page">
    <SiteHeader />
    <main id="main">
      <LibraryHero />
      <LibraryBook />
      <LibraryJournal />
      <LibraryIssues />
    </main>
    <Footer />
  </div>
</BaseLayout>

<style is:global>
  .library-page {
    /* Палитра секции: значения из заливок узлов library (267:450). */
    --library-dark: #2d2822;
    --library-umber: #3a3323;
    --library-sand: #c9bea4;
    --library-cream: #f3ede0;
    --library-muted: #6b6357;
    --library-photo: #e8e1d4;
  }
</style>
