---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructureBlock from '../components/StructureBlock.astro';
import { globalBlocks, pages, statusLabel } from '../data/structure';

const allPageBlocks = pages.flatMap((page) => page.blocks);
const pagesDone = pages.filter((page) => page.status === 'done').length;
const pagesReview = pages.filter((page) => page.status === 'review').length;
const pagesProgress = pages.filter((page) => page.status === 'progress').length;
const pagesTodo = pages.filter((page) => page.status === 'todo').length;
const blocksDone = allPageBlocks.filter((block) => block.status === 'done').length;
const blocksReview = allPageBlocks.filter((block) => block.status === 'review').length;
const blocksProgress = allPageBlocks.filter((block) => block.status === 'progress').length;
const blocksTodo = allPageBlocks.filter((block) => block.status === 'todo').length;
const globalDone = globalBlocks.filter((block) => block.status === 'done').length;
const globalReview = globalBlocks.filter((block) => block.status === 'review').length;
const globalProgress = globalBlocks.filter((block) => block.status === 'progress').length;
---

<BaseLayout
  title="Структура сайта — Syntonia"
  description="Внутренняя карта Syntonia v2: страницы, блоки, статусы и превью."
  noindex
>
  <div class="structure">
    <header class="top">
      <div class="top__bar">
        <p class="kicker">Внутренняя карта · localhost · не индексируется</p>
        <div class="top__links">
          <span class="live" data-structure-live><i></i><span>live</span></span>
          <a class="back" href="/progress.html">живой прогресс →</a>
          <a class="back" href="/">← на главную</a>
        </div>
      </div>
      <h1>Структура сайта</h1>
      <p class="lead">
        Что уже собрано, что делает каждый блок и что осталось. У каждого
        собранного блока — Figma-секция и текущая сборка; для legal/404, которых
        нет в Figma, слева — старая сборка. Для журнальных шаблонов и экранов
        quiz cover/thanks превью нет. Ссылки ведут на локальный сервер.
      </p>

      <div class="stats">
        <div class="stat" data-stat="pages">
          <span class="stat__label">Страницы</span>
          <strong>{pagesDone} / {pages.length}</strong>
          <span class="stat__hint">готово · {pagesReview} на приёмке · {pagesTodo} не начато</span>
        </div>
        <div class="stat" data-stat="blocks">
          <span class="stat__label">Блоки страниц</span>
          <strong>{blocksDone} / {allPageBlocks.length}</strong>
          <span class="stat__hint">{blocksReview} на приёмке · {blocksTodo} не начато</span>
        </div>
        <div class="stat" data-stat="global">
          <span class="stat__label">Общие блоки</span>
          <strong>{globalDone} / {globalBlocks.length}</strong>
          <span class="stat__hint">{globalReview} на приёмке · {globalBlocks.length - globalDone - globalReview} не начато</span>
        </div>
        <div class="stat">
          <span class="stat__label">Сервер</span>
          <strong>4321</strong>
          <span class="stat__hint">127.0.0.1:4321</span>
        </div>
      </div>

      <div class="legend">
        <span class="legend__item"><i class="dot dot--done"></i>готово</span>
        <span class="legend__item"><i class="dot dot--review"></i>на приёмке</span>
        <span class="legend__item"><i class="dot dot--progress"></i>в работе</span>
        <span class="legend__item"><i class="dot dot--todo"></i>не начато</span>
      </div>

      <p class="workflow">
        Блок не совпал? В канбане найди карточку с его названием — например,{' '}
        <code>Home · Formats</code> — и перетащи её в «В работе». Названия
        карточек совпадают с подписями на этой странице.
      </p>

      <p class="cards-summary">
        Счётчики и последние события — на <a href="/progress.html">живом прогрессе</a>.
        Статусы этой страницы — снимок на момент сборки.
      </p>
    </header>

    <section class="global" aria-labelledby="global-title">
      <div class="section-head">
        <div>
          <p class="section-kicker">На всех страницах</p>
          <h2 id="global-title">Общие блоки</h2>
        </div>
        <span class="section-count">2</span>
      </div>
      <div class="blocks blocks--global">
        {
          globalBlocks.map((block) => (
            <StructureBlock
              block={block}
              pageRoute="/"
              anchorId={`block-${block.id}`}
              cardLabel={`Shared · ${block.title}`}
              liveCardTitle={`Shared · ${block.title}`}
              pageId="shared"
            />
          ))
        }
      </div>
    </section>

    {
      pages.map((page) => (
        <section
          class:list={['page-card', `page-card--${page.status}`]}
          id={page.id}
          data-page-id={page.id}
          data-status={page.status}
          aria-labelledby={`page-${page.id}`}
        >
          <div class="page-card__head">
            <span class="page-card__num" aria-hidden="true">{page.number}</span>
            <div class="page-card__title">
              <h2 id={`page-${page.id}`}>{page.title}</h2>
              <p class="page-card__note">{page.note}</p>
            </div>
            <span class:list={['badge', `badge--${page.status}`]}>
              {statusLabel[page.status]}
            </span>
            <a class="page-card__open" href={page.route} target="_blank" rel="noreferrer">
              Открыть страницу
              <span aria-hidden="true">→</span>
            </a>
          </div>

          {page.preview && (
            <a class="page-card__preview" href={page.route} target="_blank" rel="noreferrer">
              <img src={page.preview} alt={`Снимок страницы «${page.title}»`} width="1440" height="760" loading="lazy" data-preview-id={page.id} />
            </a>
          )}

          <div class="page-card__meta">
            <span>Макет: {page.height}</span>
            <span>Блоков: {page.blocks.length}</span>
            <span>Маршрут: {page.route}</span>
          </div>

          <div class="page-card__blocks">
            {
              page.blocks.map((block) => (
                <StructureBlock
                  block={block}
                  pageRoute={page.route}
                  anchorId={`block-${page.id}-${block.id}`}
                  cardLabel={`${page.id === 'home' ? 'Home' : page.id === 'method' ? 'Method' : 'Page'} · ${page.id === 'home' || page.id === 'method' ? block.title : page.title}`}
                  liveCardTitle={page.id === 'home' ? `Home · ${block.title}` : page.id === 'method' ? `Method · ${block.title}` : undefined}
                  pageId={page.id}
                />
              ))
            }
          </div>
        </section>
      ))
    }

    <footer class="foot">
      <p>
        Карта собрана из <code>src/data/structure.ts</code> и
        <code>docs/site-structure.md</code>. Статусы синхронизированы с канбаном
        вручную; пиксельные хвосты — в README.
      </p>
      <p class="foot__warn">
        Method: секции экспортированы из Figma 06.11, старый рендер больше не
        используется как эталон.
      </p>
    </footer>
  </div>
</BaseLayout>


<script>
  const structureStatus = (column) =>
    column === 'done'
      ? 'done'
      : column === 'review'
        ? 'review'
        : column === 'progress'
          ? 'progress'
          : 'todo';
  const structureLabel = {
    done: 'готово',
    review: 'на приёмке',
    progress: 'в работе',
    todo: 'не начато',
  };
  const pageCards = {
    masters: 'Page · Мастера',
    practice: 'Page · Пространство практики',
    library: 'Page · Библиотека',
    booking: 'Page · Запись',
    quiz: 'Page · Quiz',
    offer: 'Page · Публичная оферта',
    privacy: 'Page · Политика конфиденциальности',
    consent: 'Page · Согласие на обработку',
    '404': 'Page · 404',
  };

  const setStatus = (element, status) => {
    if (!element || element.dataset.status === status) return;
    element.dataset.status = status;
    const classes = [...element.classList].filter((name) => !name.startsWith('block--') && !name.startsWith('page-card--'));
    element.className = [...classes, `${element.classList.contains('block') ? 'block' : 'page-card'}--${status}`].join(' ');
    const badge = element.querySelector('.block__status, .badge');
    if (badge) {
      badge.textContent = structureLabel[status];
      if (badge.classList.contains('badge')) {
        badge.className = `badge badge--${status}`;
      }
    }
  };

  const renderStats = () => {
    const pageDoms = [...document.querySelectorAll('[data-page-id]')];
    const blockDoms = [...document.querySelectorAll('.block[data-status]')];
    const globalDoms = [...document.querySelectorAll('.global .block[data-status]')];
    const counts = (list) => list.reduce((acc, el) => {
      acc[el.dataset.status] = (acc[el.dataset.status] || 0) + 1;
      return acc;
    }, {});
    const pageCounts = counts(pageDoms);
    const blockCounts = counts(blockDoms.filter((el) => !el.closest('.global')));
    const globalCounts = counts(globalDoms);
    const apply = (name, list, data) => {
      const root = document.querySelector(`[data-stat="${name}"]`);
      if (!root) return;
      const strong = root.querySelector('strong');
      const hint = root.querySelector('.stat__hint');
      if (strong) strong.textContent = `${data.done || 0} / ${list.length}`;
      if (hint) {
        const parts = [];
        if (data.review) parts.push(`${data.review} на приёмке`);
        if (data.progress) parts.push(`${data.progress} в работе`);
        if (data.todo) parts.push(`${data.todo} не начато`);
        hint.textContent = parts.join(' · ') || 'все готовы';
      }
    };
    apply('pages', pageDoms, pageCounts);
    apply('blocks', blockDoms.filter((el) => !el.closest('.global')), blockCounts);
    apply('global', globalDoms, globalCounts);
  };

  const syncStructure = async () => {
    const indicator = document.querySelector('[data-structure-live]');
    try {
      const response = await fetch(`/kanban/api/board?ts=${Date.now()}`, { cache: 'no-store' });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const payload = await response.json();
      const cards = payload?.board?.cards;
      if (!Array.isArray(cards)) throw new Error('no cards');
      const byTitle = new Map(cards.map((card) => [card.title, card.column]));

      document.querySelectorAll('[data-page-id]').forEach((section) => {
        const id = section.dataset.pageId;
        const title = pageCards[id];
        if (title && byTitle.has(title)) setStatus(section, structureStatus(byTitle.get(title)));
      });
      document.querySelectorAll('[data-live-card]').forEach((block) => {
        const title = block.dataset.liveCard;
        if (title && byTitle.has(title)) setStatus(block, structureStatus(byTitle.get(title)));
      });
      const rank = { done: 0, review: 1, progress: 2, todo: 3 };
      document.querySelectorAll('[data-page-id]').forEach((section) => {
        if (pageCards[section.dataset.pageId]) return;
        const statuses = [...section.querySelectorAll('.block[data-status]')].map((block) => block.dataset.status);
        const worst = statuses.reduce((acc, status) => (rank[status] > rank[acc] ? status : acc), 'done');
        setStatus(section, worst);
      });
      renderStats();
      indicator?.classList.add('is-live');
      const text = indicator?.querySelector('span');
      if (text) text.textContent = 'live';
    } catch {
      indicator?.classList.remove('is-live');
      const text = indicator?.querySelector('span');
      if (text) text.textContent = 'снимок';
    }
  };

  const previewVersions = new Map();
  const refreshPreviews = async () => {
    try {
      const response = await fetch(`/structure/pages/live/version.json?ts=${Date.now()}`, {
        cache: 'no-store',
      });
      if (!response.ok) return;
      const payload = await response.json();
      const versions = payload?.pages ?? {};
      Object.entries(versions).forEach(([id, version]) => {
        if (!version || previewVersions.get(id) === version) return;
        previewVersions.set(id, version);
        const image = document.querySelector(`[data-preview-id="${id}"]`);
        if (image) image.src = `/structure/pages/live/${id}.jpg?v=${encodeURIComponent(version)}`;
        document.querySelectorAll(`[data-block-page="${id}"] [data-block-image]`).forEach((blockImage) => {
          if (!blockImage.dataset.baseSrc) blockImage.dataset.baseSrc = blockImage.getAttribute('src').split('?')[0];
          blockImage.src = `${blockImage.dataset.baseSrc}?v=${encodeURIComponent(version)}`;
        });
      });
    } catch {
      /* статический снимок остаётся fallback */
    }
  };

  syncStructure();
  refreshPreviews();
  window.setInterval(syncStructure, 2500);
  window.setInterval(refreshPreviews, 2500);
</script>

<style>
  .structure {
    max-width: 1440px;
    margin: 0 auto;
    padding: 40px 24px 72px;
    color: var(--color-text);
  }

  .top {
    padding-bottom: 24px;
    border-bottom: 1px solid #d8cfbc;
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #7a756d;
    font-family: var(--font-body);
    font-size: 10px;
    line-height: 18px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #b7b0a3;
  }

  .live.is-live i {
    background: #6f7540;
  }

  .top__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }

  .top__links {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .kicker,
  .section-kicker {
    color: var(--color-accent);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    line-height: 18px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .back {
    color: var(--color-olive);
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 20px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  h1 {
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 300;
    line-height: 64px;
  }

  .lead {
    max-width: 820px;
    margin-top: 12px;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 30px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 24px;
  }

  .stat {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    border: 1px solid #e2d8c3;
    border-radius: 12px;
    background: #fffdf8;
  }

  .stat__label {
    color: #7a756d;
    font-family: var(--font-body);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .stat strong {
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 300;
    line-height: 38px;
  }

  .stat__hint {
    color: #7a756d;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 18px;
  }

  .legend {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 24px;
  }

  .legend__item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #6b6357;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 18px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #7a756d;
  }

  .dot--done {
    background: #6f7540;
  }

  .dot--progress,
  .dot--review {
    background: #b8870a;
  }

  .dot--todo {
    background: #b7b0a3;
  }

  .workflow {
    margin-top: 18px;
    padding: 10px 12px;
    border-left: 2px solid #b8870a;
    border-radius: 0 8px 8px 0;
    background: #f7edda;
    color: #6b5526;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 19px;
  }

  .workflow code {
    color: #5a4a24;
  }

  .cards-summary {
    margin-top: 8px;
    color: #8b8478;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 18px;
  }

  .global {
    margin-top: 32px;
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
  }

  .section-head h2 {
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 300;
    line-height: 42px;
  }

  .section-count {
    color: #8b8478;
    font-family: var(--font-body);
    font-size: 12px;
  }

  .blocks {
    display: grid;
    gap: 14px;
  }

  .blocks--global {
    grid-template-columns: 1fr 1fr;
  }

  .page-card {
    margin-top: 22px;
    padding: 20px;
    border: 1px solid #e2d8c3;
    border-radius: 18px;
    background: #fffdf8;
  }

  .page-card--progress,
  .page-card--review {
    border-color: #d8bd82;
  }

  .page-card--todo {
    background: #fdfaf4;
  }

  .page-card__head {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) auto auto;
    align-items: start;
    gap: 14px;
  }

  .page-card__num {
    color: #b7ad98;
    font-family: var(--font-quote);
    font-size: 26px;
    font-style: italic;
    line-height: 34px;
  }

  .page-card__title h2 {
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 300;
    line-height: 42px;
    overflow-wrap: anywhere;
  }

  .page-card__note {
    max-width: 760px;
    overflow-wrap: anywhere;
    margin-top: 3px;
    color: #6b6357;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 21px;
  }

  .badge {
    padding: 3px 10px;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 11px;
    line-height: 18px;
    white-space: nowrap;
  }

  .badge--done {
    background: #e7ead8;
    color: #51552f;
  }

  .badge--progress,
  .badge--review {
    background: #f3e6c9;
    color: #7a5a13;
  }

  .badge--todo {
    background: #ece8df;
    color: #7a756d;
  }

  .page-card__open {
    color: var(--color-olive);
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 20px;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .page-card__preview {
    display: block;
    width: min(100%, 640px);
    margin: 0 24px 14px;
    overflow: hidden;
    border: 1px solid #e2d8c3;
    border-radius: 10px;
  }

  .page-card__preview img {
    display: block;
    width: 100%;
    max-height: 220px;
    object-fit: cover;
    object-position: 50% 0;
  }

  .page-card__meta {
    margin: 10px 0 14px 66px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    color: #8b8478;
    font-family: var(--font-body);
    font-size: 11px;
    line-height: 18px;
  }

  .page-card__blocks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .page-card--todo .page-card__blocks {
    grid-template-columns: repeat(3, 1fr);
  }

  .page-card--todo .page-card__blocks :global(.shots--empty) {
    min-height: 50px;
  }

  .foot {
    margin-top: 32px;
    padding-top: 18px;
    border-top: 1px solid #d8cfbc;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    color: #7a756d;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 19px;
  }

  .foot code {
    color: #5a5a36;
  }

  .foot__warn {
    color: #8a6a1f;
    max-width: 420px;
  }

  @media (max-width: 1100px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }

    .page-card__blocks,
    .page-card--todo .page-card__blocks,
    .blocks--global {
      grid-template-columns: 1fr 1fr;
    }

    .page-card__head {
      grid-template-columns: 44px minmax(0, 1fr);
    }

    .badge,
    .page-card__open {
      justify-self: start;
    }

    .page-card__preview {
    display: block;
    width: min(100%, 640px);
    margin: 0 24px 14px;
    overflow: hidden;
    border: 1px solid #e2d8c3;
    border-radius: 10px;
  }

  .page-card__preview img {
    display: block;
    width: 100%;
    max-height: 220px;
    object-fit: cover;
    object-position: 50% 0;
  }

  .page-card__meta {
      margin-left: 58px;
    }
  }

  @media (max-width: 760px) {
    .structure {
      padding: 24px 16px 56px;
    }

    h1 {
      font-size: 40px;
      line-height: 46px;
    }

    .lead {
      font-size: 16px;
      line-height: 26px;
    }

    .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #7a756d;
    font-family: var(--font-body);
    font-size: 10px;
    line-height: 18px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #b7b0a3;
  }

  .live.is-live i {
    background: #6f7540;
  }

  .top__bar {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 18px;
