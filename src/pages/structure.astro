---
/**
 * Внутренняя карта: все страницы и секции живого файла со статусами, числами,
 * счётчиками выгруженного и парой превью «Figma / сделано».
 *
 * Данные не пишутся руками — их собирает tools/structure.mjs из артефактов.
 * noindex: страница для работы, а не для посетителей.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import structure from '../../design/figma/structure.json';

const { pages, totals, file, at } = structure;

const LABEL = {
  green: 'зелёный',
  measured: 'геометрия ок',
  red: 'красные ворота',
  exported: 'выгружен',
  todo: 'не выгружен',
};

const FILTERS = [
  { key: 'all', label: 'все' },
  { key: 'green', label: 'зелёные' },
  { key: 'exported', label: 'выгружены' },
  { key: 'todo', label: 'не выгружены' },
];

const when = new Date(at).toLocaleString('ru-RU', { dateStyle: 'short', timeStyle: 'short' });

const size = (bytes) => {
  if (!bytes) return '—';
  if (bytes < 1024) return `${bytes} Б`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} КБ`;
  return `${(bytes / 1024 / 1024).toFixed(1)} МБ`;
};

/** Готовая постановка задачи: копируется кнопкой в блоке. */
function taskText(page, s) {
  const lines = [
    `Секция: ${page.title} / ${s.name} — узел ${s.id}`,
    `Размер: ${s.w}×${s.h}, y ${s.y}`,
    s.slug ? `Спека: design/figma/sections/${s.slug}/spec.json` : 'Спека: не выгружена',
    s.slug ? `Кроп: design/figma/sections/${s.slug}/crop.png` : '',
    s.assets ? `Выгружено: ${s.assets.nodes} узлов, ${s.assets.images} фото, ${s.assets.svg} svg, ${size(s.assets.bytes)}` : '',
    s.gate
      ? `Геометрия: ${s.gate.red === 0 ? '0 нарушений' : `${s.gate.red} нарушений`}, Δ max ${s.gate.worstDelta.toFixed(2)} px, размечено ${s.gate.marked} из ${s.gate.nodes}`
      : 'Геометрия: не мерилась',
    s.pixel ? `Пиксель: средняя ${s.pixel.mean}, > 16 ${s.pixel.over16} %, > 48 ${s.pixel.over48} %` : 'Пиксель: не мерился',
    `Статус: ${LABEL[s.status.key] ?? s.status.key}`,
    '',
    'Задача: ',
  ];
  return lines.filter(Boolean).join('\n');
}

const collected = (page) => page.sections.filter((s) => s.images.site).length;
const exported = (page) => page.sections.filter((s) => s.status.key !== 'todo').length;
---

<BaseLayout title="Структура — Syntonia">
  <main class="map">
    <header class="map__head">
      <p class="map__kicker">Внутренняя карта · не индексируется</p>
      <h1 class="t-h2 map__title">Структура</h1>
      <p class="map__lead t-body">
        {file.name} · <code>{file.key}</code> · снято {when}. Статус выводится из
        артефактов: спека → ворота → сверка.
      </p>

      <dl class="stats">
        <div class="stats__item">
          <dt>Секций в Figma</dt>
          <dd>{totals.total}</dd>
        </div>
        <div class="stats__item">
          <dt>Выгружено</dt>
          <dd>{totals.total - totals.todo}</dd>
        </div>
        <div class="stats__item stats__item--ok">
          <dt>Зелёных</dt>
          <dd>{totals.green}</dd>
        </div>
        <div class="stats__item">
          <dt>Собрано</dt>
          <dd>{pages.reduce((n, p) => n + collected(p), 0)}</dd>
        </div>
      </dl>
    </header>

    <div class="toolbar" data-toolbar>
      <div class="toolbar__filters" role="group" aria-label="Фильтр по статусу">
        {FILTERS.map((f) => (
          <button class="chip" type="button" data-filter={f.key} aria-pressed={f.key === 'all' ? 'true' : 'false'}>
            {f.label}
          </button>
        ))}
      </div>

      <label class="search">
        <span class="search__icon" aria-hidden="true">⌕</span>
        <input type="search" placeholder="найти секцию или страницу" data-search />
      </label>

      <span class="toolbar__count" data-count>{totals.total} секций</span>
    </div>

    <nav class="jump" aria-label="Страницы">
      {pages.map((page) => (
        <a class="jump__item" href={`#page-${page.key}`}>
          {page.title}
          <span>{exported(page)}/{page.counts.total}</span>
        </a>
      ))}
    </nav>

    {pages.map((page) => (
      <section class="page" id={`page-${page.key}`} data-page={page.key}>
        <div class="page__head">
          <h2 class="t-h4 page__title">{page.title}</h2>
          <span class="page__meta">
            {page.frame.w}×{page.frame.h}
            {' · '}в Figma {page.counts.total}
            {' · '}выгружено {exported(page)}
            {' · '}собрано {collected(page)}
            {' · '}зелёных {page.counts.green ?? 0}
          </span>
        </div>

        <ol class="blocks">
          {page.sections.map((s) => (
            <li
              class:list={['block', `block--${s.status.key}`]}
              id={`block-${s.id.replace(':', '-')}`}
              data-status={s.status.key}
              data-search-text={`${page.title} ${s.name} ${s.id} ${s.slug ?? ''}`.toLowerCase()}
            >
              <div class="block__top">
                <span class="block__name">{s.name}</span>
                <span class:list={['badge', `badge--${s.status.key}`]}>{LABEL[s.status.key] ?? s.status.key}</span>
                <button
                  class="copy"
                  type="button"
                  title="скопировать постановку задачи"
                  aria-label={`Скопировать задачу по секции ${s.name}`}
                  data-task={taskText(page, s)}
                >копировать</button>
              </div>

              <p class="block__meta">
                <code>{s.id}</code> · {s.w}×{s.h} · y {s.y}
              </p>

              {s.assets && (
                <ul class="assets">
                  <li><b>{s.assets.nodes}</b> узлов</li>
                  <li><b>{s.assets.images}</b> фото{s.assets.jpg || s.assets.png ? ` ${[s.assets.jpg && `jpg ${s.assets.jpg}`, s.assets.png && `png ${s.assets.png}`].filter(Boolean).join('/')}` : ''}</li>
                  <li><b>{s.assets.svg}</b> svg</li>
                  <li class="assets__size">{size(s.assets.bytes)}</li>
                </ul>
              )}

              <p class="block__nums">
                {s.gate
                  ? `геометрия ${s.gate.red === 0 ? '0' : s.gate.red} · Δ ${s.gate.worstDelta.toFixed(2)} px`
                  : 'геометрия —'}
                {' · '}
                {s.pixel ? `пиксель ${s.pixel.mean} · >16 ${s.pixel.over16} %` : 'пиксель —'}
              </p>

              <div class="block__shots">
                {s.images.figma ? (
                  <figure class="shot">
                    <a href={s.images.figma} target="_blank" rel="noreferrer">
                      <img src={s.images.figma} alt={`Figma: ${s.name}`} loading="lazy" />
                    </a>
                    <figcaption>Figma</figcaption>
                  </figure>
                ) : (
                  <div class="shot shot--empty">нет эталона</div>
                )}

                {s.images.site ? (
                  <figure class="shot">
                    <a href={s.images.site} target="_blank" rel="noreferrer">
                      <img src={s.images.site} alt={`Сборка: ${s.name}`} loading="lazy" />
                    </a>
                    <figcaption>сделано</figcaption>
                  </figure>
                ) : (
                  <div class="shot shot--empty">не собрано</div>
                )}
              </div>
            </li>
          ))}
        </ol>

        <p class="page__empty" data-empty hidden>по этому фильтру на странице ничего нет</p>
      </section>
    ))}
  </main>
</BaseLayout>

<script>
  const chips = [...document.querySelectorAll('[data-filter]')];
  const search = document.querySelector('[data-search]');
  const counter = document.querySelector('[data-count]');
  const blocks = [...document.querySelectorAll('.block')];
  const pageSections = [...document.querySelectorAll('[data-page]')];
  const jumps = [...document.querySelectorAll('.jump__item')];

  let status = 'all';
  let query = '';

  function apply() {
    let shown = 0;
    for (const block of blocks) {
      const byStatus = status === 'all' || block.dataset.status === status;
      const byText = !query || (block.dataset.searchText ?? '').includes(query);
      const visible = byStatus && byText;
      block.hidden = !visible;
      if (visible) shown++;
    }
    for (const section of pageSections) {
      const visible = section.querySelectorAll('.block:not([hidden])').length;
      section.hidden = visible === 0;
      const empty = section.querySelector('[data-empty]');
      if (empty) empty.hidden = visible > 0;
    }
    for (const jump of jumps) {
      const id = jump.getAttribute('href')?.slice(1);
      jump.hidden = !!document.getElementById(id)?.hidden;
    }
    counter.textContent = `${shown} из ${blocks.length}`;
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      status = chip.dataset.filter;
      for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
      apply();
    });
  }

  search?.addEventListener('input', () => {
    query = search.value.trim().toLowerCase();
    apply();
  });

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      search?.focus();
    }
    if (event.key === 'Escape' && document.activeElement === search) {
      search.value = '';
      query = '';
      apply();
      search.blur();
    }
  });

  // Копирование постановки задачи. navigator.clipboard требует secure context,
  // поэтому есть запасной путь через textarea.
  async function copyText(text) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.append(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok;
    }
  }

  for (const button of document.querySelectorAll('[data-task]')) {
    button.addEventListener('click', async () => {
      const ok = await copyText(button.dataset.task ?? '');
      const label = button.textContent;
      button.textContent = ok ? 'скопировано' : 'не вышло';
      button.classList.toggle('copy--done', ok);
      setTimeout(() => {
        button.textContent = label;
        button.classList.remove('copy--done');
      }, 1600);
    });
  }

  apply();
</script>

<style>
  .map {
    max-width: 1600px;
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-l) var(--space-4xl);
  }

  .map__kicker {
    margin-bottom: var(--space-xs);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .map__title {
    margin-bottom: var(--space-s);
    font-size: 40px;
    color: var(--color-text-heading);
  }

  .map__lead {
    max-width: 760px;
    margin-bottom: var(--space-m);
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  code {
    font-family: var(--font-golos-text);
    font-size: 0.92em;
    color: var(--color-text-deep);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 var(--space-m);
  }

  .stats__item {
    min-width: 104px;
    padding: 6px 14px;
    background: var(--color-bg-surface);
    border-radius: var(--radius-s);
  }

  .stats__item dt {
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .stats__item dd {
    margin: 0;
    font-family: var(--font-literata);
    font-size: 22px;
    line-height: 1.2;
    color: var(--color-text-heading);
  }

  .stats__item--ok {
    background: var(--color-bg-muted);
  }

  .toolbar {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 8px 0;
    margin-bottom: 8px;
    background: var(--color-bg-page);
    border-bottom: 1px solid var(--color-border);
  }

  .toolbar__filters {
    display: flex;
    gap: 4px;
  }

  .chip {
    padding: 4px 12px;
    font-size: 12px;
    color: var(--color-text-deep);
    background: var(--color-bg-surface);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
  }

  .chip[aria-pressed='true'] {
    color: var(--color-text-on-image);
    background: var(--color-accent);
  }

  .search {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    background: var(--color-bg-surface);
    border-radius: 999px;
  }

  .search__icon {
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  .search input {
    width: 200px;
    font: inherit;
    font-size: 12px;
    color: var(--color-text-primary);
    background: transparent;
    border: 0;
    outline: none;
  }

  .toolbar__count {
    margin-left: auto;
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: var(--space-l);
  }

  .jump__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    font-size: 12px;
    color: var(--color-text-primary);
    background: var(--color-bg-surface);
    border-radius: var(--radius-xs);
  }

  .jump__item span {
    font-size: 10px;
    color: var(--color-text-secondary);
  }

  .page {
    margin-bottom: var(--space-2xl);
    scroll-margin-top: 56px;
  }

  .page__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
    padding-bottom: 4px;
    margin-bottom: var(--space-s);
    border-bottom: 1px solid var(--color-border);
  }

  .page__title {
    font-size: 22px;
    color: var(--color-text-heading);
  }

  .page__meta {
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  .page__empty {
    font-size: 12px;
    font-style: italic;
    color: var(--color-text-secondary);
  }

  /* Две колонки: карта длинная, а блоки узкие. */
  .blocks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 12px;
    background: var(--color-bg-surface);
    border-radius: var(--radius-s);
    border-left: 3px solid var(--color-border);
  }

  .block--green {
    border-left-color: var(--color-accent);
  }

  .block--red {
    border-left-color: #a4463c;
  }

  .block__top {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .block__name {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-heading);
  }

  .badge {
    padding: 1px 6px;
    font-size: 9px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: 3px;
    background: var(--color-bg-muted);
    color: var(--color-text-deep);
    white-space: nowrap;
  }

  .badge--green {
    background: var(--color-accent);
    color: var(--color-text-on-image);
  }

  .badge--red {
    background: #a4463c;
    color: #fff;
  }

  .copy {
    margin-left: auto;
    padding: 2px 8px;
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    background: var(--color-bg-page);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    cursor: pointer;
    white-space: nowrap;
  }

  .copy:hover {
    color: var(--color-text-primary);
    border-color: var(--color-accent-muted);
  }

  .copy--done {
    color: var(--color-text-on-image);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .block__meta,
  .block__nums {
    margin: 0;
    font-size: 11px;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }

  .block__nums {
    color: var(--color-text-deep);
  }

  .assets {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 10px;
    color: var(--color-text-secondary);
  }

  .assets li {
    padding: 1px 6px;
    background: var(--color-bg-page);
    border-radius: 3px;
  }

  .assets b {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .block__shots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    margin-top: 4px;
  }

  .shot {
    margin: 0;
    overflow: hidden;
    background: var(--color-bg-page);
    border-radius: 3px;
  }

  .shot img {
    display: block;
    width: 100%;
    height: 92px;
    object-fit: cover;
    object-position: top;
    transition: transform 0.2s ease;
  }

  .shot a:hover img {
    transform: scale(1.03);
  }

  .shot figcaption {
    padding: 2px 6px;
    font-size: 9px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .shot--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 92px;
    font-size: 10px;
    color: var(--color-text-secondary);
    border: 1px dashed var(--color-border);
  }

  @media (max-width: 1000px) {
    .blocks {
      grid-template-columns: 1fr;
    }
  }
</style>
