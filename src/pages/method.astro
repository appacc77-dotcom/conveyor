---
/**
 * Страница метода — заглушка на время пересборки.
 *
 * Секции снесены вместе с выгрузкой: страница собирается заново по конвейеру,
 * чтобы проверить его после доработок. Пока секций нет, страница держит шапку
 * и подвал, чтобы ссылки в меню вели на существующий адрес.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Метод Syntonia" description="Страница пересобирается.">
  <main class="page">
    <Header />
    <Footer />
  </main>
</BaseLayout>

<style>
  .page {
    position: relative;
  }
</style>
