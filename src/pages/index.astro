---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Pain from '../components/Pain.astro';
import Banner from '../components/Banner.astro';
import Header from '../components/Header.astro';
import Formats from '../components/Formats.astro';
import Entry from '../components/Entry.astro';
import Method from '../components/Method.astro';
import Quiz from '../components/Quiz.astro';
import AboutFounder from '../components/AboutFounder.astro';
import Process from '../components/Process.astro';
import AirPhoto from '../components/AirPhoto.astro';

const painItems = [
  {
    number: '01',
    text: 'Если жизнь идёт, а всё будто стоит на месте',
    nodes: {
      item: '79:123',
      row: 'I79:123;42:70',
      number: 'I79:123;42:71',
      text: 'I79:123;42:72',
      divider: 'I79:123;42:74',
    },
  },
  {
    number: '02',
    text: 'Если попыток было уже столько, а по-настоящему легче так и не стало',
    nodes: {
      item: '79:124',
      row: 'I79:124;42:70',
      number: 'I79:124;42:71',
      text: 'I79:124;42:72',
      divider: 'I79:124;42:74',
    },
  },
  {
    number: '03',
    text: 'Если ты устаёшь носить в себе напряжение, тяжесть или скрытую боль',
    nodes: {
      item: '79:125',
      row: 'I79:125;42:70',
      number: 'I79:125;42:71',
      text: 'I79:125;42:72',
      divider: 'I79:125;42:74',
    },
  },
  {
    number: '04',
    text: 'Если тебе нужна глубокая и точная внутренняя работа',
    nodes: {
      item: '79:126',
      row: 'I79:126;42:70',
      number: 'I79:126;42:71',
      text: 'I79:126;42:72',
      divider: 'I79:126;42:74',
    },
  },
];
---

<BaseLayout title="Syntonia — состояние, из которого строится жизнь">
  <main class="page">
    <Header />
    <Hero
      title="Состояние, из которого строится жизнь"
      lead="Когда меняется внутреннее основание, меняются выборы, отношения, энергия и жизнь."
      ctaLabel="Узнать свой код реальности"
      ctaHref="/quiz.html"
    />

    <Banner
      title="Перемены в жизни начинаются изнутри"
      signature="by Ekaterina Lebedeva"
    />

    <Pain
      title="Когда нужен не просто разговор, а реальные перемены в жизни"
      lead="Если в отношениях снова больно, в выборе нет опоры, внутри тяжело, а энергии всё меньше — причина внутри, и это можно изменить"
      script="Начни"
      ctaLabel="с точки входа"
      ctaHref="/booking.html#entry"
      items={painItems}
    />

    <Method
      eyebrow="Метод Syntonia"
      lead="Неблагоприятные линии жизни мы часто называем судьбой."
      turn="Но существует выход из предначертанного."
      title="Там, где начинается новый выбор"
      ctaLabel="Как это работает"
    />

    <Quiz
      title="Диагностика состояния"
      segments={[
        { text: 'Тест ', style: 'script-l' },
        { text: 'поможет увидеть, что сейчас управляет твоим состоянием и жизнью', style: 'body' },
      ]}
      ctaLabel="понять себя"
      meta={['Бесплатно', '2-3 минуты']}
    />

    <AboutFounder
      name="Екатерина Лебедева"
      meta={[
        { text: 'Психолог', w: 94 },
        { text: 'основатель Syntonia', w: 203 },
        { text: 'глубже слов', w: 121 },
      ]}
      quote="«Я не работаю вокруг проблемы. Я веду к её источнику»."
      ctaLabel="Познакомиться ближе"
    />

    <Process
      title="Как проходит работа?"
      stages={[
        {
          order: 'text-first',
          title: 'Сначала становится ясно, что с тобой происходит на самом деле',
          text: 'Не нужно подбирать слова. Открывается, из какого состояния ты живёшь и почему жизнь снова складывается именно так.',
          image: '/img/process-1.png',
          size: '136.10% 100%',
          position: '100% 0',
          nodes: { card: '79:170', content: 'I79:170;61:78', title: 'I79:170;61:73', body: 'I79:170;61:76', line: 'I79:170;61:75', text: 'I79:170;61:74', image: 'I79:170;61:79' },
        },
        {
          order: 'image-first',
          title: 'Затем мы идём в глубину причины',
          text: 'Вместе находим, где берут начало чувства, реакции и выборы, которые сегодня управляют твоей жизнью.',
          image: '/img/process-2.png',
          size: '110.52% 100%',
          position: '0% 0',
          nodes: { card: '79:171', content: 'I79:171;65:94', title: 'I79:171;65:96', body: 'I79:171;65:97', line: 'I79:171;65:98', text: 'I79:171;65:99', image: 'I79:171;65:100' },
        },
        {
          order: 'text-first',
          title: 'И программа отпускает',
          text: 'Это не облегчение на время, а выход. Старое растворяется, в сердце просыпается тепло. И дальше ты идёшь со своим светом, легко и свободно.',
          image: '/img/process-3.png',
          size: '173.83% 157.20%',
          position: '64.14% 42.77%',
          nodes: { card: '79:172', content: 'I79:172;61:78', title: 'I79:172;61:73', body: 'I79:172;61:76', line: 'I79:172;61:75', text: 'I79:172;61:74', image: 'I79:172;61:79' },
        },
      ]}
    />

    <Entry
      title="С чего начать"
      lead="Бережно и точно. Ясность в том, что с тобой происходит."
      name="Точка входа"
      desc="Первая встреча. Ты увидишь, из какого состояния сейчас строится твоя жизнь, и почувствуешь, как звучит эта работа, прежде чем идти дальше."
      meta={['Онлайн', '30 минут']}
      ctaLabel="Начать с точки входа"
      secondaryLabel="Форматы работы"
      photoText={['Рядом,', 'даже на расстоянии']}
    />
    <Formats
      title="Форматы работы"
      lead="Форматы различаются по глубине запроса, длительности и степени сопровождения."
      note="Переход к записи ни к чему не обязывает: сначала ты можешь задать вопросы, оплата идёт последним шагом."
      slide="1/5"
      tabs={[
        { node: '709:1504', number: '01', title: 'Точка входа', duration: '30 мин', price: '$50', active: true,
          desc: 'Первая встреча. Твоё понимание, что мешает и куда двигаться. Дальше выбор за тобой.' },
        { node: '709:1520', number: '02', title: 'Индивидуальная мастер-сессия', duration: '2 часа', price: '$230' },
        { node: '709:1544', number: '03', title: 'Программа 3\u00a0встречи', duration: '3 х 2 часа', price: '$650', divider: true },
        { node: '709:1554', number: '04', title: 'Программа 5\u00a0встреч', duration: '5 х 2 часа', price: '$1050', divider: true },
        { node: '709:1564', number: '05', title: 'Сопровождение', duration: '60 минут', price: '$110', divider: true },
      ]}
    />
  </main>
</BaseLayout>

<style>
  /* Шапка позиционируется абсолютно: ей нужен позиционированный родитель. */
  .page {
    position: relative;
  }
</style>
