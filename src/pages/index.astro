---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import BannerFounder from '../components/BannerFounder.astro';
import Pain from '../components/Pain.astro';
import Method from '../components/Method.astro';
import Quiz from '../components/Quiz.astro';
import AboutFounder from '../components/AboutFounder.astro';
import Process from '../components/Process.astro';
import Entry from '../components/Entry.astro';
import Formats from '../components/Formats.astro';
import Voices from '../components/Voices.astro';
import Library from '../components/Library.astro';
import AirPhoto from '../components/AirPhoto.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Syntonia — Состояние, из которого строится жизнь"
  description="Syntonia — глубинный метод работы с человеком. Когда меняется внутреннее основание, меняются выборы, отношения, энергия и жизнь."
>
  <SiteHeader />
  <main id="main">
    <Hero />
    <BannerFounder />
    <Pain />
    <Method />
    <Quiz />
    <AboutFounder />
    <Process />
    <Entry />
    <Formats />
    <Voices />
    <Library />
    <AirPhoto />
    <Faq />
  </main>

  <Footer />
</BaseLayout>
