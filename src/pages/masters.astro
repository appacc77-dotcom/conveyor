---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import MastersHero from '../components/MastersHero.astro';
import MastersTeam from '../components/MastersTeam.astro';
import MastersMore from '../components/MastersMore.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Мастера — Syntonia"
  description="Екатерина Лебедева, основатель Syntonia, и мастера пространства."
>
  <div class="masters-page">
    <SiteHeader />
    <main id="main">
      <MastersHero />
      <MastersTeam />
      <MastersMore />
    </main>
    <Footer />

    <div
      class="masters-toast"
      role="status"
      aria-live="polite"
      hidden
      data-masters-toast
    >
    </div>
  </div>

  <script>
    const toast = document.querySelector('[data-masters-toast]');
    const message =
      'Аудиозапись ещё не загружена — появится после передачи файлов.';
    let timer;

    document.querySelectorAll('[data-audio-stub]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!toast) return;
        toast.textContent = message;
        toast.hidden = false;
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          toast.hidden = true;
        }, 4000);
      });
    });
  </script>
</BaseLayout>

<style is:global>
  body {
    /* Тёмная тема страницы «Мастера»: фон Figma #2d2822. */
    background: #2d2822;
  }
</style>

<style>
  .masters-page {
    --masters-bg: #2d2822;
    --masters-white: #ffffff;
    --masters-sand: #c9bea4;
    --masters-text: #d8cbb6;
    --masters-olive: #5a5a36;
    --masters-accent: #8a8560;
    --masters-line: rgba(201, 190, 164, 0.35);
    --masters-ink: #433d34;
    --masters-ink-soft: #6b6357;
    background: var(--masters-bg);
  }

  .masters-toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 200;
    max-width: min(92vw, 480px);
    padding: 12px 20px;
    border-radius: 8px;
    background: #3a3323;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
    color: var(--masters-white);
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 22px;
    transform: translateX(-50%);
  }

  .masters-toast[hidden] {
    display: none;
  }
</style>
