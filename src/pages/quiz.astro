---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Тест состояния — Syntonia"
  description="Короткий тест: понять, какое состояние сейчас сильнее всего влияет на жизнь."
>
  <div class="quiz-page">
    <SiteHeader />
    <main id="main">
      <img
        class="quiz-page__bg"
        src="/img/quiz-page-bg.jpg"
        alt=""
        width="1672"
        height="941"
      />
      <div class="quiz-page__inner">
        <div class="quiz-intro" data-quiz-intro>
          <p class="quiz-intro__eyebrow">диагностика</p>
          <h1 class="quiz-intro__title" id="page-title">Тест состояния</h1>
          <p class="quiz-intro__lead">
            Отвечайте так, как чувствуете именно сейчас.
          </p>
          <ul class="quiz-intro__meta">
            <li>3 минуты</li>
            <li data-quiz-count>4 вопроса</li>
            <li>ваш текущий код и практика в подарок</li>
          </ul>
        </div>

        <form class="quiz-card" data-quiz-form novalidate>
          <div class="quiz-card__top">
            <div class="quiz-card__progress">
              <p class="quiz-card__step" data-quiz-step>Вопрос 1 из 4</p>
              <div class="quiz-card__bar" aria-hidden="true">
                <span data-quiz-bar></span>
              </div>
            </div>
            <p class="quiz-card__percent" data-quiz-percent>25% пройдено</p>
          </div>

          <fieldset class="quiz-card__question">
            <legend class="quiz-card__text" data-quiz-question></legend>
            <div class="quiz-card__options" data-quiz-options></div>
          </fieldset>

          <div class="quiz-card__nav">
            <button class="quiz-card__back" type="button" data-quiz-back>
              ← Назад
            </button>
            <button class="quiz-card__next" type="submit" data-quiz-next>
              Далее
            </button>
          </div>
          <p class="quiz-card__error" data-quiz-error hidden>
            Выберите один вариант, чтобы продолжить.
          </p>
        </form>

        <section
          class="quiz-result"
          data-quiz-result
          tabindex="-1"
          aria-live="polite"
          hidden
        >
          <button class="quiz-result__back" type="button" data-quiz-restart>
            ← Пройти заново
          </button>
          <p class="quiz-result__eyebrow">ваш результат</p>
          <h2 class="quiz-result__title" data-result-title></h2>
          <p class="quiz-result__subtitle" data-result-subtitle></p>
          <p class="quiz-result__lead" data-result-lead></p>

          <div class="result-card">
            <div class="result-card__body">
              <p class="result-card__eyebrow">о вашем состоянии</p>
              <h3 class="result-card__title" data-result-state></h3>
              <div class="result-card__meaning" data-result-meaning></div>
              <a class="result-card__link" href="/practice.html#codes">
                Открыть практики кода →
              </a>
            </div>
            <figure class="result-card__photo">
              <img
                src="/img/quiz-result.jpg"
                alt="Женщина в льняной накидке смотрит на море на закате"
                width="900"
                height="1200"
                loading="lazy"
              />
            </figure>
          </div>

          <div class="quiz-result__actions">
            <a class="quiz-result__action" href="/practice.html#codes">
              <span>Продолжить путь</span>
              Полная практика вашего кода
            </a>
            <a class="quiz-result__action" href="/booking.html#entry">
              <span>Личная встреча</span>
              Начать с точки входа
            </a>
          </div>
        </section>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>

<script>
  const quiz = {
    questions: [
      {
        text: 'Какая мысль чаще всего звучит внутри — фоном, даже когда вы заняты другим?',
        options: [
          { text: 'Я не понимаю, чего хочу и куда идти', code: 'fear' },
          { text: 'Так не должно было быть. Это несправедливо', code: 'anger' },
          { text: 'Это уже не вернуть. Всё было зря', code: 'pain' },
          { text: 'Всё вокруг раздражает — люди, ситуации, мелочи', code: 'anger' },
          { text: 'Справляюсь со всем без чьей-либо помощи', code: 'warmth' },
          { text: 'А вдруг снова не получится', code: 'fear' },
          { text: 'Мне хорошо с собой — и этого достаточно', code: 'warmth' },
        ],
      },
      {
        text: 'Что происходит с вами, когда что-то идёт не по плану?',
        options: [
          { text: 'Сжимаюсь и жду худшего', code: 'fear' },
          { text: 'Злюсь — на себя или на других', code: 'anger' },
          { text: 'Становится больно и хочется закрыться', code: 'pain' },
          { text: 'Беру всё на себя и справляюсь', code: 'warmth' },
        ],
      },
      {
        text: 'Где в теле чаще всего ощущается напряжение?',
        options: [
          { text: 'В груди — тяжесть, ком', code: 'pain' },
          { text: 'В животе — тревога, холод', code: 'fear' },
          { text: 'В челюсти и плечах — зажим', code: 'anger' },
          { text: 'Скорее усталость во всём теле', code: 'warmth' },
        ],
      },
      {
        text: 'Чего вам сейчас не хватает больше всего?',
        options: [
          { text: 'Опоры и уверенности в завтрашнем дне', code: 'fear' },
          { text: 'Спокойствия и терпения', code: 'anger' },
          { text: 'Близости и понимания', code: 'pain' },
          { text: 'Тепла и заботы о себе', code: 'warmth' },
        ],
      },
    ],
    results: {
      pain: {
        title: 'Код Боли',
        subtitle: 'Возвращение к себе',
        lead: 'Это состояние сейчас сильнее всего влияет на вашу жизнь. Ниже — его описание и практика, которая поможет сделать первый шаг к изменениям.',
        state: 'Вы многое чувствуете и глубоко переживаете',
        meaning: [
          'Внутри вас может быть ощущение утраты, усталости, разочарования. Прожитый опыт всё ещё отзывается, и иногда кажется, что это мешает двигаться дальше. Вы склонны держать боль в себе, стараетесь быть сильным для других, но при этом вам важно, чтобы вас увидели и поняли.',
          'Это не слабость, а показатель вашей глубокой чувствительности. Именно она делает вас живым, настоящим, способным на близость и искренность. Сейчас для вас особенно важно бережно поддержать себя и вернуть контакт со своими чувствами.',
        ],
      },
      fear: {
        title: 'Код Страха',
        subtitle: 'Право двигаться вперёд',
        lead: 'Это состояние сейчас сильнее всего влияет на вашу жизнь.',
        state: 'Вам важно вернуть опору и разрешение двигаться',
        meaning: [
          'Страх часто появляется там, где раньше уже было больно. Он бережёт вас, но иногда становится слишком большим и не даёт сделать следующий шаг.',
        ],
      },
      anger: {
        title: 'Код Гнева',
        subtitle: 'Сила без борьбы',
        lead: 'Это состояние сейчас сильнее всего влияет на вашу жизнь.',
        state: 'В вас много силы, которой нужен безопасный выход',
        meaning: [
          'Гнев показывает, где нарушены ваши границы. Его энергия может стать ясностью и действием, если перестать бороться с собой.',
        ],
      },
      warmth: {
        title: 'Код Тепла',
        subtitle: 'Активация',
        lead: 'Это состояние сейчас сильнее всего влияет на вашу жизнь.',
        state: 'У вас уже есть контакт с собой — его можно углубить',
        meaning: [
          'Внутреннее тепло — это источник силы. Сейчас важно не торопиться, а бережно поддержать то, что уже начинает раскрываться.',
        ],
      },
    },
  };

  const form = document.querySelector('[data-quiz-form]');
  if (form) {
    const optionsEl = form.querySelector('[data-quiz-options]');
    const questionEl = form.querySelector('[data-quiz-question]');
    const stepEl = form.querySelector('[data-quiz-step]');
    const percentEl = form.querySelector('[data-quiz-percent]');
    const barEl = form.querySelector('[data-quiz-bar]');
    const errorEl = form.querySelector('[data-quiz-error]');
    const nextBtn = form.querySelector('[data-quiz-next]');
    const backBtn = form.querySelector('[data-quiz-back]');
    const resultEl = document.querySelector('[data-quiz-result]');
    const introEl = document.querySelector('[data-quiz-intro]');
    const resultTitle = document.querySelector('[data-result-title]');
    const resultSubtitle = document.querySelector('[data-result-subtitle]');
    const resultLead = document.querySelector('[data-result-lead]');
    const resultState = document.querySelector('[data-result-state]');
    const resultMeaning = document.querySelector('[data-result-meaning]');

    let index = 0;
    let selected = null;
    const answers = [];

    const render = () => {
      const question = quiz.questions[index];
      const progress = Math.round(((index + 1) / quiz.questions.length) * 100);
      questionEl.textContent = question.text;
      stepEl.textContent = `Вопрос ${index + 1} из ${quiz.questions.length}`;
      percentEl.textContent = `${progress}% пройдено`;
      barEl.style.width = `${progress}%`;
      errorEl.hidden = true;
      optionsEl.replaceChildren(
        ...question.options.map((option) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'quiz-option';
          button.setAttribute('aria-pressed', 'false');
          button.textContent = option.text;
          button.addEventListener('click', () => {
            selected = option.code;
            optionsEl.querySelectorAll('.quiz-option').forEach((item) => {
              item.setAttribute('aria-pressed', String(item === button));
            });
            errorEl.hidden = true;
          });
          return button;
        }),
      );
      selected = null;
      backBtn.hidden = index === 0;
      nextBtn.textContent =
        index === quiz.questions.length - 1 ? 'Показать результат' : 'Далее';
    };

    const showResult = () => {
      const counts = answers.reduce((acc, code) => {
        acc[code] = (acc[code] || 0) + 1;
        return acc;
      }, {});
      const code = Object.keys(counts).sort((a, b) => counts[b] - counts[a])[0];
      const result = quiz.results[code] || quiz.results.pain;
      form.hidden = true;
      introEl.hidden = true;
      resultEl.hidden = false;
      resultTitle.textContent = result.title;
      resultSubtitle.textContent = result.subtitle;
      resultLead.textContent = result.lead;
      resultState.textContent = result.state;
      resultMeaning.replaceChildren(
        ...result.meaning.map((paragraph) => {
          const item = document.createElement('p');
          item.textContent = paragraph;
          return item;
        }),
      );
      resultEl.focus({ preventScroll: true });
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!selected) {
        errorEl.hidden = false;
        return;
      }
      answers[index] = selected;
      if (index === quiz.questions.length - 1) {
        showResult();
        return;
      }
      index += 1;
      render();
    });

    backBtn.addEventListener('click', () => {
      if (index === 0) return;
      index -= 1;
      selected = answers[index] || null;
      render();
    });

    document.querySelector('[data-quiz-restart]')?.addEventListener('click', () => {
      index = 0;
      answers.length = 0;
      selected = null;
      resultEl.hidden = true;
      introEl.hidden = false;
      form.hidden = false;
      render();
      form.focus({ preventScroll: true });
    });

    render();
  }
</script>

<style is:global>
  .quiz-page {
    position: relative;
    min-height: 1218px;
    overflow: hidden;
    background: #fbf8f1;
  }

  .quiz-page__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 20% center;
    opacity: 0.55;
  }

  .quiz-page__bg + .quiz-page__inner {
    position: relative;
    z-index: 1;
  }

  .quiz-page::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, rgba(251, 248, 241, 0.15), rgba(251, 248, 241, 0.88));
    pointer-events: none;
  }

  .quiz-page__inner {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 110px 24px 9px;
  }

  .quiz-intro {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .quiz-intro__eyebrow,
  .quiz-result__eyebrow,
  .result-card__eyebrow {
    color: #8a6a1f;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    line-height: 18px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .quiz-intro__title {
    margin-top: 10px;
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 46px;
    font-weight: 300;
    line-height: 52px;
  }

  .quiz-intro__lead {
    margin-top: 12px;
    color: #5f594f;
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 28px;
  }

  .quiz-intro__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 18px;
    margin-top: 16px;
    color: #6b6357;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 20px;
  }

  .quiz-intro__meta li + li::before {
    content: "·";
    margin-right: 18px;
    color: #8a8560;
  }

  .quiz-card,
  .quiz-result {
    width: 760px;
    max-width: 100%;
    margin: 16px auto 0;
    padding: 18px;
    border: 1px solid #e2d8c3;
    border-radius: 16px;
    background: rgba(251, 248, 241, 0.96);
    box-shadow: 0 24px 60px rgba(58, 51, 35, 0.12);
  }

  .quiz-card__top {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px 16px;
    align-items: center;
  }

  .quiz-card__progress {
    grid-column: 1 / -1;
  }

  .quiz-card__step,
  .quiz-card__percent {
    color: #7a756d;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 18px;
  }

  .quiz-card__percent {
    grid-row: 1;
    grid-column: 2;
    align-self: start;
  }

  .quiz-card__bar {
    height: 3px;
    margin-top: 8px;
    overflow: hidden;
    border-radius: 3px;
    background: #e5ddce;
  }

  .quiz-card__bar span {
    display: block;
    height: 100%;
    width: 25%;
    transition: width 0.25s ease;
    background: #5a5a36;
  }

  .quiz-card__question {
    margin: 24px 0 0;
    padding: 0;
    border: 0;
  }

  .quiz-card__text {
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 27px;
    font-weight: 300;
    line-height: 36px;
  }

  .quiz-card__options {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 12px;
  }

  .quiz-option {
    width: 100%;
    padding: 9px 12px;
    border: 1px solid #d8cfbc;
    border-radius: 9px;
    background: #fffdf8;
    color: #433d34;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 19px;
    text-align: left;
    cursor: pointer;
  }

  .quiz-option:hover {
    border-color: #8a8560;
  }

  .quiz-option[aria-pressed="true"] {
    border-color: #5a5a36;
    background: #ece8d9;
  }

  .quiz-card__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 16px;
  }

  .quiz-card__back {
    color: #6b6357;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 18px;
  }

  .quiz-card__next {
    padding: 11px 18px;
    border-radius: 4px;
    background: #5a5a36;
    color: #fffdf8;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 18px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .quiz-card__error {
    margin-top: 12px;
    color: #8a3f1f;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 18px;
  }

  .quiz-result {
    box-shadow: none;
  }

  .quiz-result__back {
    margin-bottom: 18px;
    color: #6b6357;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 18px;
  }

  .quiz-result__title {
    margin-top: 8px;
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 42px;
    font-weight: 300;
    line-height: 50px;
  }

  .quiz-result__subtitle {
    margin-top: 4px;
    color: #8a6a1f;
    font-family: var(--font-quote);
    font-size: 20px;
    font-style: italic;
    line-height: 28px;
  }

  .quiz-result__lead {
    margin-top: 14px;
    color: #5f594f;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 24px;
  }

  .result-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 20px;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid #e2d8c3;
  }

  .result-card__title {
    margin-top: 6px;
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 300;
    line-height: 34px;
  }

  .result-card__meaning p {
    margin-top: 10px;
    color: #5f594f;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 23px;
  }

  .result-card__link {
    display: inline-block;
    margin-top: 14px;
    color: #5a5a36;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 20px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .result-card__photo {
    overflow: hidden;
    border-radius: 10px;
    background: #e1d5c4;
  }

  .result-card__photo img {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
  }

  .quiz-result__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 18px;
  }

  .quiz-result__action {
    padding: 9px 12px;
    border: 1px solid #d8cfbc;
    border-radius: 9px;
    color: #433d34;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 20px;
  }

  .quiz-result__action span {
    display: block;
    margin-bottom: 2px;
    color: #8a6a1f;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .quiz-page {
      min-height: 0;
    }

    .quiz-page__inner {
      padding: 124px 16px 56px;
    }

    .quiz-intro__title {
      font-size: 40px;
      line-height: 46px;
    }

    .quiz-card,
    .quiz-result {
      padding: 18px;
      margin-top: 22px;
    }

    .quiz-card__text {
      font-size: 23px;
      line-height: 31px;
    }

    .result-card {
      grid-template-columns: 1fr;
    }

    .result-card__photo {
      order: -1;
      max-height: 260px;
    }

    .result-card__photo img {
      min-height: 220px;
    }

    .quiz-result__actions {
      grid-template-columns: 1fr;
    }
  }
</style>
