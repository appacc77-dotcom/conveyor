---
/**
 * Витрина генератора: секции, собранные из спеки скриптом.
 *
 * Живёт отдельно от сайта: калибровка не имеет права менять приёмку 47
 * секций. Сюда же смотрит замер — те же спеки и кропы, что у ручных секций.
 *
 * Секции идут в порядке классов из docs/GEN-CALIBRATION.md.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import targets from '../../design/gen/targets.json';
import MethodAbout from '../components/_gen/MethodAbout.astro';
import Faq from '../components/_gen/Faq.astro';
import Formats from '../components/_gen/Formats.astro';
import FounderHero from '../components/_gen/FounderHero.astro';
import Voices from '../components/_gen/Voices.astro';
import BookingFormats from '../components/_gen/BookingFormats.astro';
---

<BaseLayout title="Генератор: витрина" noindex>
  <main class="genpage">
    <h1 class="genpage__title">Сгенерировано из спеки</h1>
    <p class="genpage__note">
      {targets.sections.length} секций по классам · абсолютная раскладка по координатам ·
      правки — в <code>design/gen/overrides/</code>
    </p>

    <div class="genpage__item"><MethodAbout /></div>
    <div class="genpage__item"><Faq /></div>
    <div class="genpage__item"><Formats /></div>
    <div class="genpage__item"><FounderHero /></div>
    <div class="genpage__item"><Voices /></div>
    <div class="genpage__item"><BookingFormats /></div>
  </main>
</BaseLayout>

<style>
  .genpage {
    padding: 40px 0;
    background: #e8e4da;
  }

  .genpage__title {
    margin: 0 0 8px;
    padding: 0 40px;
    font: 400 24px/1.2 'Golos Text', sans-serif;
    color: #433d34;
  }

  .genpage__note {
    margin: 0 0 24px;
    padding: 0 40px;
    font: 400 14px/1.5 'Golos Text', sans-serif;
    color: #6b6455;
  }

  .genpage__item {
    margin: 0 0 32px;
    width: 1440px;
  }
</style>
