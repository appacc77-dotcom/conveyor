---
interface Props {
  href: string;
  title: string;
  text: string;
  cta: string;
  image: string;
  alt: string;
  figmaNode: string;
  imagePosition?: string;
}

const {
  href,
  title,
  text,
  cta,
  image,
  alt,
  figmaNode,
  imagePosition = 'center',
} = Astro.props;
---

<a class="link-card" href={href} data-figma-node={figmaNode}>
  <img
    class="link-card__image"
    src={image}
    alt={alt}
    width="296"
    height="236"
    loading="lazy"
    style={`object-position: ${imagePosition}`}
  />
  <span class="link-card__body">
    <span class="link-card__title">{title}</span>
    <span class="link-card__text">{text}</span>
    <span class="link-card__cta">
      {cta}
      <span class="link-card__arrow" aria-hidden="true"></span>
    </span>
  </span>
</a>

<style>
  .link-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 100%;
    padding-bottom: 16px;
    overflow: hidden;
    /* Figma strokeAlign = INSIDE: обводка не добавляет 2 px к 428. */
    box-shadow: inset 0 0 0 1px var(--masters-accent);
    border-radius: 12px;
    background: var(--color-page);
    color: var(--masters-ink);
    transition: background-color 0.2s ease;
  }

  .link-card:hover {
    background: #fffaf0;
  }

  .link-card__image {
    width: 100%;
    height: 236px;
    object-fit: cover;
  }

  .link-card__body {
    flex: 1;
    padding: 0 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .link-card__title {
    color: var(--masters-ink);
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 300;
    line-height: 28px;
  }

  .link-card__text {
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    line-height: 20px;
  }

  .link-card__cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-olive);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    line-height: 20px;
    letter-spacing: 0.03em;
  }

  .link-card__arrow {
    flex: none;
    width: 14px;
    height: 14px;
    background-color: currentColor;
    -webkit-mask: url('/icons/icon-arrow.svg') center / contain no-repeat;
    mask: url('/icons/icon-arrow.svg') center / contain no-repeat;
    transition: transform 0.2s ease;
  }

  .link-card:hover .link-card__arrow {
    transform: translateX(3px);
  }

  @media (max-width: 1100px) {
    .link-card__image {
      height: 200px;
    }
  }

  @media (max-width: 700px) {
    .link-card__image {
      height: auto;
      aspect-ratio: 296 / 236;
    }
  }
</style>
