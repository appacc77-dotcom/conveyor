---
const issues = [
  {
    number: '№02',
    title: 'Тело и состояние',
    text: 'Как внутреннее состояние управляет нашими решениями — и что делать, когда выбор даётся с трудом.',
    image: '/img/journal-issue-02.jpg',
    alt: 'Обложка журнала Syntonia.Life, выпуск 02',
  },
  {
    number: '№01',
    title: 'Внутренняя опора',
    text: 'О том, как найти устойчивость внутри, когда снаружи всё меняется. Состояния, практики и способ слышать себя.',
    image: '/img/journal-issue-01.jpg',
    alt: 'Обложка журнала Syntonia.Life, выпуск 01',
  },
  {
    number: '№00',
    title: 'Вступительное слово',
    text: 'Что собой представляют выпуски журнала Syntonia.Life, и как сделать чтение максимально удобным и эффективным.',
    image: '/img/journal-issue-00.jpg',
    alt: 'Обложка журнала Syntonia.Life, выпуск 00',
  },
  {
    number: '№03',
    title: 'СКОРО',
    text: 'Превью для будущего выпуска',
    image: '/img/journal-issue-03.jpg',
    alt: 'Обложка журнала Syntonia.Life, выпуск 03',
    soon: true,
  },
];
---

<section
  class="issues"
  aria-labelledby="issues-title"
  data-figma-node="272:1044"
>
  <div class="issues__inner">
    <div class="issues__head">
      <h2 class="issues__title" id="issues-title">Все выпуски</h2>
      <a class="issues__all" href="#issues-list">
        <span>смотреть все</span>
        <span class="issues__arrow" aria-hidden="true"></span>
      </a>
    </div>

    <ul class="issues__list" id="issues-list" aria-labelledby="issues-title">
      {
        issues.map((issue) => (
          <li class="issue-card">
            <div class="issue-card__media">
              <img
                class="issue-card__cover"
                src={issue.image}
                alt={issue.alt}
                width="296"
                height="236"
                loading="lazy"
              />
              <div class="issue-card__name">
                <p class="issue-card__num">{issue.number}</p>
                <h3 class="issue-card__title">{issue.title}</h3>
              </div>
            </div>

            <p class="issue-card__text">{issue.text}</p>

            {issue.soon ? (
              <span class="issue-card__soon">СКОРО</span>
            ) : (
              <a class="issue-card__link" href="#" data-draft>
                <span>открыть выпуск</span>
                <span class="issue-card__arrow" aria-hidden="true" />
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .issues {
    padding-block: 56px;
    background: var(--color-page);
  }

  .issues__inner {
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .issues__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .issues__title {
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 300;
    line-height: 1.2;
  }

  .issues__all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-olive);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    line-height: 29px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .issues__arrow {
    width: 16px;
    height: 16px;
    background-color: currentColor;
    -webkit-mask: url('/icons/icon-arrow.svg') center / contain no-repeat;
    mask: url('/icons/icon-arrow.svg') center / contain no-repeat;
  }

  .issues__list {
    margin-top: 24px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }

  .issue-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .issue-card__media {
    position: relative;
    aspect-ratio: 296 / 236;
    overflow: hidden;
    border-radius: 4px 4px 0 0;
    background: var(--library-photo);
  }

  .issue-card__cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 44% 48%;
  }

  /* Заливка узла journal-cover: светлая вуаль у нижнего левого края,
     тёмная — у верхнего правого, слой 55 %. */
  .issue-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      45deg,
      rgba(209, 193, 170, 0.12) 10%,
      rgba(58, 51, 35, 0.48) 78%
    );
  }

  .issue-card__name {
    position: absolute;
    z-index: 1;
    top: 16px;
    left: 16px;
    max-width: 167px;
    color: var(--color-white);
  }

  .issue-card__num,
  .issue-card__title {
    margin: 0;
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 300;
    line-height: 20px;
  }

  .issue-card__text {
    margin-top: 16px;
    color: var(--library-muted);
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 400;
    line-height: 24px;
  }

  .issue-card__link,
  .issue-card__soon {
    align-self: flex-start;
    margin-top: 8px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 27px;
    padding: 4px 8px;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px var(--color-olive);
    color: var(--color-olive);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    line-height: 19px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .issue-card__soon {
    cursor: default;
  }

  .issue-card__arrow {
    flex: none;
    width: 14px;
    height: 14px;
    background-color: currentColor;
    -webkit-mask: url('/icons/icon-arrow.svg') center / contain no-repeat;
    mask: url('/icons/icon-arrow.svg') center / contain no-repeat;
  }

  @media (min-width: 768px) {
    .issues {
      padding-block: 64px;
    }

    .issues__inner {
      padding-inline: 32px;
    }

    .issues__title {
      font-size: 32px;
    }

    .issues__all {
      font-size: 16px;
    }

    .issues__arrow {
      width: 18px;
      height: 18px;
    }

    .issues__list {
      margin-top: 32px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px;
    }
  }

  @media (min-width: 1200px) {
    .issues {
      padding-block: 64px;
    }

    .issues__inner {
      padding-inline: 80px;
    }

    /* Строка «Все выпуски» — 48 px: 35/48 слева, «смотреть все» 18/29 справа. */
    .issues__head {
      flex-wrap: nowrap;
      height: 48px;
    }

    .issues__title {
      font-size: 35px;
      line-height: 48px;
    }

    .issues__all {
      font-size: 18px;
      line-height: 29px;
    }

    .issues__arrow {
      width: 19px;
      height: 19px;
    }

    .issues__list {
      margin-top: 32px;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 32px;
    }

    .issue-card__media {
      height: 236px;
      aspect-ratio: auto;
      border-radius: 4px 4px 0 0;
    }

    /* Карточка 296×347: обложка 236, 16, текст 60, 8, кнопка 27. */
    .issue-card__text {
      margin-top: 16px;
      height: 60px;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      font-size: 20px;
      line-height: 20px;
    }

    .issue-card__link {
      font-size: 17px;
      line-height: 19px;
    }

    .issue-card__soon {
      font-size: 14px;
      line-height: 19px;
    }
  }
</style>
