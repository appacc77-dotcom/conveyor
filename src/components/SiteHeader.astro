---
import Button from './Button.astro';

const rawPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const normalize = (href: string) =>
  (href.replace(/\.html$/, '').replace(/\/+$/, '') || '/');
const isCurrent = (href: string) => normalize(rawPath) === normalize(href);
const aboutCurrent = isCurrent('/method.html') || isCurrent('/masters.html');
---

<header class="site-header" data-site-header data-figma-node="167:641">
  <div class="site-header__inner">
    <nav class="nav" aria-label="Основная навигация">
      <details class="nav__dropdown">
        <summary class:list={['nav__link', 'nav__summary', { 'is-current': aboutCurrent }]}>
          О проекте
          <img
            class="nav__chevron"
            src="/icons/icon-chevron.svg"
            alt=""
            width="14"
            height="14"
          />
        </summary>
        <ul class="nav__menu">
          <li><a href="/method.html" aria-current={isCurrent('/method.html') ? 'page' : undefined}>Метод Syntonia</a></li>
          <li><a href="/masters.html" aria-current={isCurrent('/masters.html') ? 'page' : undefined}>Мастера</a></li>
        </ul>
      </details>
      <a class="nav__link" href="/quiz.html" aria-current={isCurrent('/quiz.html') ? 'page' : undefined}>Понять себя</a>
      <a class="nav__link" href="/practice.html" aria-current={isCurrent('/practice.html') ? 'page' : undefined}>Пространство практики</a>
    </nav>

    <a class="logo" href="/index.html" aria-label="Syntonia — на главную">
      <img
        src="/icons/logo-gold.svg"
        alt="Syntonia — Evolution of Consciousness"
        width="168"
        height="60"
      />
    </a>

    <div class="actions">
      <div class="actions__cta">
        <Button
          href="/booking.html"
          label="Личная встреча"
          variant="textured"
          caps
          class="btn--header"
        />
      </div>
      <a class="login" href="#" aria-label="Личный кабинет (скоро)">
        <img src="/icons/icon-profile.svg" alt="" width="45" height="45" />
      </a>
      <button
        class="burger"
        type="button"
        aria-label="Открыть меню"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-label="Меню" hidden data-mobile-menu>
    <ul class="mobile-menu__list">
      <li>
        <a class="mobile-menu__link" href="/method.html" aria-current={isCurrent('/method.html') ? 'page' : undefined}>
          Метод Syntonia
        </a>
      </li>
      <li>
        <a class="mobile-menu__link" href="/masters.html" aria-current={isCurrent('/masters.html') ? 'page' : undefined}>
          Мастера
        </a>
      </li>
      <li>
        <a class="mobile-menu__link" href="/quiz.html" aria-current={isCurrent('/quiz.html') ? 'page' : undefined}>
          Понять себя
        </a>
      </li>
      <li>
        <a class="mobile-menu__link" href="/practice.html" aria-current={isCurrent('/practice.html') ? 'page' : undefined}>
          Пространство практики
        </a>
      </li>
      <li>
        <a class="mobile-menu__link" href="/library.html" aria-current={isCurrent('/library.html') ? 'page' : undefined}>
          Библиотека
        </a>
      </li>
      <li>
        <a class="mobile-menu__link" href="/index.html#voices-title">Отзывы</a>
      </li>
      <li>
        <a class="mobile-menu__link" href="/index.html#faq-title">Вопросы и ответы</a>
      </li>
    </ul>
    <a class="mobile-menu__cta" href="/booking.html">
      Личная встреча
      <img src="/icons/icon-arrow.svg" alt="" width="14" height="14" />
    </a>
  </nav>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  if (header) {
    const toggle = header.querySelector('[data-menu-toggle]');
    const menu = header.querySelector('[data-mobile-menu]');

    if (toggle && menu) {
      const focusableSelector =
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
      const getFocusables = () =>
        Array.from(menu.querySelectorAll(focusableSelector)).filter(
          (element) => element.getClientRects().length > 0,
        );

      const setOpen = (open, { restoreFocus = false } = {}) => {
        const wasOpen = !menu.hidden;
        menu.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
        toggle.classList.toggle('is-open', open);
        header.classList.toggle('is-menu-open', open);

        if (open) {
          getFocusables()[0]?.focus({ preventScroll: true });
        } else if (wasOpen && restoreFocus) {
          toggle.focus({ preventScroll: true });
        }
      };

      toggle.addEventListener('click', () => {
        const open = menu.hidden;
        setOpen(open, { restoreFocus: !open });
      });

      document.addEventListener('keydown', (event) => {
        if (menu.hidden) return;

        if (event.key === 'Escape') {
          event.preventDefault();
          setOpen(false, { restoreFocus: true });
          return;
        }

        if (event.key !== 'Tab') return;

        const focusables = getFocusables();
        if (!focusables.length) return;

        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const active = document.activeElement;

        if (!menu.contains(active)) {
          event.preventDefault();
          (event.shiftKey ? last : first).focus();
          return;
        }

        if (event.shiftKey && active === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && active === last) {
          event.preventDefault();
          first.focus();
        }
      });

      document.addEventListener('click', (event) => {
        if (menu.hidden) return;
        if (menu.contains(event.target) || toggle.contains(event.target)) return;
        setOpen(false, { restoreFocus: true });
      });

      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          setOpen(false, { restoreFocus: true });
          window.setTimeout(() => toggle.focus({ preventScroll: true }), 0);
        });
      });
    }
  }
</script>

<style>
  .site-header {
    position: fixed;
    top: 8px;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .site-header__inner {
    width: min(1424px, calc(100% - 16px));
    height: 92px;
    padding: 0 32px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-radius: var(--radius-header);
    background: var(--color-header);
    box-shadow: inset 0 0 0 0.5px rgba(138, 133, 96, 0.9);
    pointer-events: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav__link {
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    line-height: 34px;
    white-space: nowrap;
  }

  .nav__dropdown {
    position: relative;
  }

  .nav__summary {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    cursor: pointer;
  }

  .nav__summary::-webkit-details-marker {
    display: none;
  }

  .nav__chevron {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }

  .nav__dropdown[open] .nav__chevron {
    transform: rotate(180deg);
  }

  .nav__menu {
    position: absolute;
    top: calc(100% + 14px);
    left: -12px;
    min-width: 220px;
    padding: 8px;
    display: grid;
    gap: 2px;
    border-radius: 12px;
    background: rgba(58, 51, 35, 0.98);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
  }

  .nav__menu a {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    color: var(--color-white);
    font-size: 17px;
    line-height: 1.4;
  }

  .nav__menu a:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .logo {
    justify-self: center;
    display: block;
    width: 168px;
    height: 60px;
  }

  .logo img {
    width: 100%;
    height: 100%;
  }

  .actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .actions__cta {
    margin-right: -8px;
  }

  .login {
    display: block;
    width: 45px;
    height: 45px;
    border-radius: var(--radius-btn);
  }

  .login img {
    width: 45px;
    height: 45px;
  }

  .burger {
    --burger-line-width: 38px;
    --burger-line-gap: 8px;
    width: 44px;
    height: 44px;
    margin-inline-end: calc((var(--burger-line-width) - 44px) / 2);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--burger-line-gap);
  }

  .burger span {
    display: block;
    width: var(--burger-line-width);
    height: 3px;
    border-radius: 4px;
    background: var(--color-white);
  }

  .nav__link[aria-current="page"],
  .nav__summary.is-current {
    color: #e4d3a6;
  }

  .mobile-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    width: min(1424px, calc(100% - 16px));
    max-height: calc(100vh - 120px);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    overflow: auto;
    border-radius: 16px;
    background: rgba(58, 51, 35, 0.98);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.28);
    transform: translateX(-50%);
    pointer-events: auto;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu__list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mobile-menu__link {
    display: block;
    padding: 10px 14px;
    border-radius: 8px;
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    line-height: 34px;
  }

  .mobile-menu__link:hover,
  .mobile-menu__link[aria-current="page"] {
    background: rgba(255, 255, 255, 0.08);
    color: #e4d3a6;
  }

  .mobile-menu__cta {
    margin-top: 8px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-radius: 8px;
    background: var(--color-olive);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 29px;
  }

  .mobile-menu__cta img {
    width: 14px;
    height: 14px;
  }

  .burger.is-open span:nth-child(1) {
    transform: translateY(calc(3px + var(--burger-line-gap))) rotate(45deg);
  }

  .burger.is-open span:nth-child(2) {
    opacity: 0;
  }

  .burger.is-open span:nth-child(3) {
    transform: translateY(calc(-3px - var(--burger-line-gap))) rotate(-45deg);
  }

  .burger span {
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  @media (max-width: 1320px) {
    .nav {
      display: none;
    }

    .site-header__inner {
      grid-template-columns: 1fr auto;
    }

    .logo {
      justify-self: start;
    }
  }

  @media (max-width: 700px) {
    .site-header {
      top: 6px;
    }

    .site-header__inner {
      width: calc(100% - 12px);
      height: 72px;
      padding: 0 16px;
    }

    .logo {
      width: 150px;
      height: 54px;
    }

    .login {
      display: none;
    }

    .burger {
      --burger-line-width: 32px;
      --burger-line-gap: 6px;
    }
  }
</style>
