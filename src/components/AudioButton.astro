---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<button
  class:list={['master-audio', className]}
  type="button"
  data-audio-stub
>
  <span class="master-audio__label">{label}</span>
  <img
    class="master-audio__arrow"
    src="/icons/icon-arrow.svg"
    alt=""
    width="14"
    height="14"
  />
</button>

<style>
  .master-audio {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: none;
    height: 45px;
    padding: 8px 16px;
    border-radius: var(--radius-btn);
    background-color: var(--masters-olive);
    background-image: url('/img/btn-texture.jpg');
    background-size: cover;
    background-position: center;
    color: var(--masters-white);
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 400;
    line-height: 29px;
    letter-spacing: 0.03em;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .master-audio:hover {
    opacity: 0.92;
  }

  .master-audio__arrow {
    flex: none;
    width: 14px;
    height: 14px;
    /* В Figma arrow-quiet у этой кнопки повёрнута на 90° — стрелка вниз. */
    transform: rotate(90deg);
  }
</style>
