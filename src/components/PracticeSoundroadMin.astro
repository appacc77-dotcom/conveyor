---
interface Props {
  duration: string;
  fragment: string;
  label: string;
}

const { duration, fragment, label } = Astro.props;
---

<div class="soundroad-min">
  <span class="soundroad-min__label">Фрагмент практики</span>
  <div class="soundroad-min__player">
    <button
      class="soundroad-min__play"
      type="button"
      aria-label={`Слушать фрагмент: ${label}`}
      data-practice-audio
    >
      <img src="/icons/practice-play.svg" alt="" width="41" height="41" />
    </button>
    <img
      class="soundroad-min__wave"
      src="/icons/practice-wave.svg"
      alt=""
      width="202"
      height="28"
      loading="lazy"
    />
    <span class="soundroad-min__time">{fragment}</span>
  </div>
  <span class="visually-hidden">{duration}</span>
</div>

<style>
  .soundroad-min {
    display: flex;
    flex-direction: column;
    gap: 4px;
    height: 74.8px;
  }

  .soundroad-min__label {
    color: var(--practice-accent);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 400;
    line-height: 17px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .soundroad-min__player {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 53.8px;
    padding: 0 6px;
    border: 1px solid var(--practice-accent);
    border-radius: 14px;
  }

  .soundroad-min__play {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
  }

  .soundroad-min__play img {
    width: 44px;
    height: 44px;
  }

  .soundroad-min__wave {
    flex: 1 1 auto;
    width: auto;
    min-width: 0;
    height: 22px;
    object-fit: fill;
  }

  .soundroad-min__time {
    flex: none;
    padding: 1px 7px;
    border: 1px solid var(--practice-accent);
    border-radius: 4px;
    color: var(--practice-olive);
    font-family: var(--font-body);
    font-size: 11px;
    line-height: 17px;
  }

  @media (max-width: 700px) {
    .soundroad-min {
      height: auto;
    }

    .soundroad-min__player {
      height: 52px;
    }

    .soundroad-min__play,
    .soundroad-min__play img {
      width: 40px;
      height: 40px;
    }
  }
</style>
