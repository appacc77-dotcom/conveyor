---
interface Props {
  time: string;
  teaser: string;
  playLabel: string;
  class?: string;
}

const { time, teaser, playLabel, class: className } = Astro.props;
---

<div class:list={['master-player', className]}>
  <div class="master-player__row">
    <button
      class="master-player__play"
      type="button"
      aria-label={playLabel}
      data-audio-stub
    >
      <img src="/icons/icon-play.svg" alt="" width="47" height="47" />
    </button>
    <img
      class="master-player__wave"
      src="/img/masters-wave.svg"
      alt=""
      width="222"
      height="29"
    />
    <span class="master-player__time">{time}</span>
  </div>
  <p class="master-player__teaser">{teaser}</p>
</div>

<style>
  .master-player {
    width: 344px;
    max-width: 100%;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-radius: 12px;
    background: rgba(67, 61, 52, 0.35);
  }

  .master-player__row {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .master-player__play {
    flex: none;
    width: 47px;
    height: 47px;
    border-radius: 50%;
    overflow: hidden;
  }

  .master-player__play img {
    width: 47px;
    height: 47px;
  }

  .master-player__wave {
    flex: 0 1 222px;
    width: 222px;
    min-width: 0;
    height: 29px;
  }

  .master-player__time {
    flex: none;
    margin-left: auto;
    color: var(--masters-white);
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 20px;
    white-space: nowrap;
  }

  .master-player__teaser {
    color: var(--masters-text);
    font-family: var(--font-body);
    font-size: 11px;
    line-height: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 380px) {
    .master-player__wave {
      width: 180px;
      flex-basis: 180px;
    }
  }
</style>
