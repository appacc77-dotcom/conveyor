---
import Button from './Button.astro';

const items = [
  {
    question: 'Если я уже был в терапии, мне это подойдёт?',
    answer:
      'Да и поможет. Работа идёт глубже — с внутренним состоянием, подсознательными причинами и тем, что на тонком плане управляет жизнью.',
  },
  {
    question: 'Чем этот подход отличается от обычной психологии?',
    answer:
      'Здесь важно не только понять сознательную причину, но и изменить внутреннюю реальность, из которой рождаются чувства, реакции и события.',
  },
  {
    question: 'Зачем мне это, если я уже многое о себе понял?',
    answer:
      'Потому что понимание не всегда меняет жизнь. Важно не только увидеть, но и сдвинуть саму внутреннюю точку, из которой всё строится.',
  },
  {
    question: 'Чем Точка входа отличается от мастер-сессии?',
    answer:
      'Точка входа помогает увидеть главное и понять следующий шаг. Мастер-сессия — это уже более глубокая работа с запросом.',
  },
  {
    question: 'Сколько встреч обычно нужно?',
    answer:
      'Это зависит от глубины запроса и цели. Иногда многое становится ясно уже после первой встречи. Если жизненный сценарий повторяется давно, работа может потребовать большего пути.',
  },
];
---

<section class="faq" aria-labelledby="faq-title" data-figma-node="148:508">
  <img
    class="faq__bg"
    src="/img/paper-bg.jpg"
    alt=""
    width="1672"
    height="941"
    loading="lazy"
  />

  <div class="faq__inner">
    <div class="faq__intro">
      <div class="faq__heading">
        <h2 class="faq__title" id="faq-title">
          <span class="faq__title-top">То, что<br />важно<br />ПОНЯТЬ</span>
          <span class="faq__title-bottom">перед<br />началом</span>
        </h2>
        <p class="faq__lead">
          О том, как внутренняя работа начинает менять состояние и саму жизнь
        </p>
      </div>

      <Button
        href="/booking.html#question"
        label="Задать вопрос"
        variant="textured"
        class="btn--faq"
      />
    </div>

    <div class="faq__list" data-faq>
      {
        items.map((item, index) => (
          <div
            class:list={['faq__item', { 'is-open': index === 0 }]}
            data-faq-item
          >
            <button
              class="faq__question"
              type="button"
              aria-expanded={index === 0 ? 'true' : 'false'}
              aria-controls={`faq-answer-${index}`}
            >
              <span>{item.question}</span>
              <svg
                class="faq__icon"
                viewBox="0 0 21 21"
                aria-hidden="true"
              >
                <path
                  d="M4.5 7.5 10.5 13.5 16.5 7.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <p class="faq__answer" id={`faq-answer-${index}`}>
              {item.answer}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-faq]').forEach((root) => {
    const items = [...root.querySelectorAll('[data-faq-item]')];

    items.forEach((item) => {
      const button = item.querySelector('.faq__question');
      if (!button) return;

      button.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        items.forEach((other) => {
          other.classList.remove('is-open');
          other
            .querySelector('.faq__question')
            ?.setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          item.classList.add('is-open');
          button.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>

<style>
  .faq {
    position: relative;
    height: 807px;
    padding: 128px 24px;
    overflow: hidden;
  }

  .faq__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .faq__inner {
    position: relative;
    z-index: 1;
    width: 1280px;
    max-width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 397px 835px;
    gap: 48px;
  }

  .faq__intro {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .faq__heading {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .faq__title {
    display: block;
    width: 336px;
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 300;
    line-height: 60px;
  }

  .faq__title-top {
    display: block;
    width: 208px;
  }

  .faq__title-bottom {
    display: block;
    width: 176px;
    margin-left: 160px;
    font-size: 42px;
    line-height: 53px;
  }

  .faq__lead {
    width: 397px;
    max-width: 100%;
    color: #6b6357;
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    line-height: 34px;
  }

  .faq__list {
    width: 835px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .faq__item {
    padding: 16px 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    border-radius: 12px;
    box-shadow: inset 0 0 0 1px #c9bea4;
  }

  .faq__item.is-open {
    background: rgba(255, 255, 255, 0.55);
    box-shadow: inset 0 0 0 1px rgba(201, 190, 164, 0.45);
  }

  .faq__question {
    width: 100%;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 24px;
    color: #433d34;
    font-family: var(--font-display);
    font-size: 25px;
    font-weight: 300;
    line-height: 39px;
    text-align: left;
    cursor: pointer;
  }

  .faq__question span {
    flex: 1;
  }

  .faq__icon {
    flex: none;
    width: 21px;
    height: 21px;
    color: var(--color-olive);
    transition: transform 0.2s ease;
  }

  .faq__item.is-open .faq__icon {
    transform: rotate(180deg);
  }

  .faq__answer {
    color: #6b6357;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 300;
    line-height: 34px;
  }

  .faq__item:not(.is-open) .faq__answer {
    display: none;
  }

  @media (max-width: 1100px) {
    .faq {
      height: auto;
      padding: 64px 24px;
    }

    .faq__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .faq__intro {
      gap: 32px;
    }

    .faq__heading {
      gap: 24px;
    }

    .faq__list {
      width: 100%;
    }
  }

  @media (max-width: 700px) {
    .faq {
      padding: 56px 16px;
    }

    .faq__title {
      width: 100%;
      font-size: 38px;
      line-height: 46px;
    }

    .faq__title-top {
      width: auto;
    }

    .faq__title-bottom {
      width: auto;
      margin-left: 96px;
      font-size: 34px;
      line-height: 42px;
    }

    .faq__lead {
      width: 100%;
      font-size: 17px;
      line-height: 28px;
    }

    .faq__item {
      padding: 14px 16px;
      gap: 16px;
    }

    .faq__question {
      gap: 12px;
      font-size: 20px;
      line-height: 29px;
    }

    .faq__answer {
      font-size: 17px;
      line-height: 28px;
    }
  }
</style>
