---
import PracticeSectionHead from './PracticeSectionHead.astro';
import PracticeCardPay from './PracticeCardPay.astro';
import { codePractices } from '../data/practice';
---

<section class="practice-codes" id="codes" aria-labelledby="codes-title" data-figma-node="414:1970">
  <div class="practice-codes__inner">
    <PracticeSectionHead
      id="codes-title"
      title="Коды состояний"
      subtitle="Для более глубокой самостоятельной работы с тем состоянием, которое сильнее всего влияет на жизнь сейчас."
      size="l"
    />
    <ul class="practice-codes__grid">
      {codePractices.map((item) => <PracticeCardPay item={item} />)}
    </ul>
  </div>
</section>

<style>
  .practice-codes {
    padding: 96px 0 64px;
    background: var(--practice-cream);
  }

  .practice-codes__inner {
    width: min(1280px, calc(100% - 160px));
    margin: 0 auto;
  }

  .practice-codes__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px 32px;
    margin-top: 64px;
  }

  @media (max-width: 1199px) {
    .practice-codes {
      padding: 64px 0 48px;
    }

    .practice-codes__inner {
      width: calc(100% - 80px);
    }

    .practice-codes__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      margin-top: 40px;
    }
  }

  @media (max-width: 767px) {
    .practice-codes {
      padding: 48px 0 40px;
    }

    .practice-codes__inner {
      width: calc(100% - 32px);
    }

    .practice-codes__grid {
      gap: 24px;
      margin-top: 32px;
    }
  }
</style>
