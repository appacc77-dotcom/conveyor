---
import Button from './Button.astro';
---

<section class="quiz" aria-labelledby="quiz-title" data-figma-node="79:137">
  <img
    class="quiz__bg"
    src="/img/quiz-bg.jpg"
    alt=""
    width="1280"
    height="548"
    loading="lazy"
  />
  <div class="quiz__inner">
    <h2 class="quiz__title" id="quiz-title">Диагностика состояния</h2>

    <p class="quiz__text">
      <span class="quiz__script">Тест</span> поможет увидеть, что сейчас
      управляет твоим состоянием и жизнью
    </p>

    <div class="quiz__cta">
      <Button
        href="/quiz.html"
        label="понять себя"
        caps
        class="btn--quiz"
      />
      <div class="quiz__meta">
        <span>Бесплатно</span>
        <span class="quiz__dot" aria-hidden="true"></span>
        <span>2-3 минуты</span>
      </div>
    </div>
  </div>
</section>

<style>
  .quiz {
    position: relative;
    min-height: 550px;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--color-white);
    background: #3a3323;
  }

  .quiz__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  .quiz__inner {
    position: relative;
    z-index: 1;
    width: 1280px;
    max-width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .quiz__title {
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 300;
    line-height: 60px;
  }

  .quiz__text {
    width: 520px;
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    line-height: 48px;
  }

  .quiz__script {
    font-family: var(--font-script);
    font-size: 42px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    vertical-align: -0.05em;
    margin-right: 2px;
  }

  .quiz__cta {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .quiz__meta {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    line-height: 20px;
  }

  .quiz__dot {
    display: block;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: currentColor;
  }

  @media (max-width: 1100px) {
    .quiz__inner {
      padding: 0 24px;
    }
  }

  @media (max-width: 700px) {
    .quiz {
      min-height: 480px;
    }

    .quiz__inner {
      padding: 64px 24px;
      gap: 24px;
    }

    .quiz__title {
      font-size: 34px;
      line-height: 42px;
    }

    .quiz__text {
      width: 100%;
      max-width: 100%;
      font-size: 16px;
      line-height: 30px;
    }

    .quiz__script {
      font-size: 30px;
    }

    .quiz__cta {
      flex-wrap: wrap;
      gap: 14px 20px;
    }
  }
</style>
