---
import Button from './Button.astro';
---

<section class="hero" aria-labelledby="hero-title" data-figma-node="79:105">
  <img
    class="hero__image"
    src="/img/hero.jpg"
    alt="Пустой светлый зал из травертина, в который через узкий проём падает солнечный луч"
    width="1280"
    height="720"
    fetchpriority="high"
  />
  <span class="hero__overlay" aria-hidden="true"></span>

  <div class="hero__content">
    <h1 class="hero__title" id="hero-title">
      Состояние, из которого строится жизнь
    </h1>
    <p class="hero__lead">
      Когда меняется внутреннее основание, меняются выборы, отношения, энергия
      и жизнь.
    </p>
    <Button
      href="/quiz.html"
      label="Узнать свой код реальности"
      class="btn--hero"
    />
  </div>

  <button class="hero__play" type="button" aria-label="Смотреть видео о Syntonia">
    <img src="/icons/icon-play.svg" alt="" width="47" height="47" />
  </button>
</section>

<style>
  .hero {
    position: relative;
    height: 780px;
    overflow: hidden;
    color: var(--color-white);
    background: #3a3323;
  }

  .hero__image,
  .hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__image {
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    background: var(--color-overlay);
  }

  .hero__content {
    position: absolute;
    top: 347px;
    left: 64px;
    width: 600px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .hero__title {
    max-width: 600px;
    color: var(--color-white);
    font-family: var(--font-hero);
    font-size: 64px;
    font-weight: 300;
    line-height: 64px;
    letter-spacing: 0;
  }

  .hero__lead {
    max-width: 600px;
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    line-height: 34px;
  }

  .hero__play {
    position: absolute;
    right: 64px;
    bottom: 64px;
    width: 47px;
    height: 47px;
  }

  .hero__play img {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 1100px) {
    .hero {
      height: 700px;
    }

    .hero__content {
      top: 280px;
      left: 32px;
      width: 520px;
    }

    .hero__title {
      font-size: 54px;
      line-height: 56px;
    }

    .hero__lead {
      font-size: 18px;
      line-height: 30px;
    }
  }

  @media (max-width: 700px) {
    .hero {
      height: auto;
      min-height: 640px;
    }

    .hero__content {
      position: relative;
      z-index: 1;
      top: auto;
      left: auto;
      width: auto;
      padding: 130px 24px 112px;
      gap: 24px;
    }

    .hero__title {
      font-size: 44px;
      line-height: 48px;
    }

    .hero__lead {
      font-size: 17px;
      line-height: 28px;
    }

    .hero__play {
      right: 24px;
      bottom: 24px;
      width: 40px;
      height: 40px;
    }
  }
</style>
