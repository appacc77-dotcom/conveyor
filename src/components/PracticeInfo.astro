---
const carePoints = [
  'Перед началом оцени своё состояние по шкале 0–10. Если напряжение выше 6/10 — отложи практику или сделай её с поддержкой.',
  'Поставь мягкий таймер на 10–15 минут, держи рядом воду и плед.',
  'Сообщи близкому, что ты в практике, или договорись о «якоре поддержки».',
  'Если в процессе становится хуже — остановись, открой глаза, сделай три длинных выдоха и сделай паузу.',
  'Если у тебя есть диагнозы, влияющие на психику, выраженная тревога/депрессия, частые флэшбэки или ты принимаешь психотропные препараты — выполняй практики только с поддержкой специалиста.',
];
---

<section class="practice-info" id="info" aria-labelledby="info-title" data-figma-node="435:423">
  <div class="practice-info__inner">
    <header class="practice-info__head">
      <h2 class="practice-info__title" id="info-title">Бережная практика</h2>
      <p class="practice-info__intro">
        Перед началом уделите минуту своему состоянию. Практику можно остановить
        в&nbsp;любой момент — ориентируйтесь на&nbsp;своё самочувствие и&nbsp;не
        продолжайте через сильное напряжение.
      </p>
    </header>

    <div class="practice-info__accordion">
      <details class="practice-info__item" open>
        <summary class="practice-info__summary">
          <span class="practice-info__name">
            <span class="practice-info__num">01</span>
            <span class="practice-info__divider" aria-hidden="true"></span>
            <span class="practice-info__heading">С заботой о тебе</span>
          </span>
          <img class="practice-info__chevron" src="/icons/practice-chevron-up.svg" alt="" width="12" height="15" />
        </summary>
        <div class="practice-info__panel">
          <ul class="practice-info__points">
            {carePoints.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      </details>

      <details class="practice-info__item">
        <summary class="practice-info__summary">
          <span class="practice-info__name practice-info__name--short">
            <span class="practice-info__num">02</span>
            <span class="practice-info__divider" aria-hidden="true"></span>
            <span class="practice-info__heading-group">
              <span class="practice-info__heading">SOS-алгоритм</span>
              <span class="practice-info__subheading">Короткий SOS-алгоритм, чтобы вернуться в контакт с собой и пространством.</span>
            </span>
          </span>
          <img class="practice-info__chevron" src="/icons/practice-chevron-up.svg" alt="" width="12" height="15" />
        </summary>
        <div class="practice-info__panel">
          <p class="practice-info__draft" data-draft>
            Полный текст алгоритма ожидается от заказчика.
          </p>
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  .practice-info {
    padding: 64px 0;
    background: var(--practice-info-bg);
  }

  .practice-info__inner {
    width: min(1280px, calc(100% - 160px));
    margin: 0 auto;
  }

  .practice-info__head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 16px 0;
    text-align: center;
  }

  .practice-info__title {
    color: var(--practice-heading);
    font-family: var(--font-display);
    font-size: 65px;
    font-weight: 300;
    line-height: 1.25;
  }

  .practice-info__intro {
    max-width: 1148px;
    margin: 0 auto;
    color: var(--practice-text);
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    line-height: 34px;
  }

  .practice-info__accordion {
    margin-top: 48px;
    overflow: hidden;
    border: 1px solid var(--practice-accent);
    border-radius: 8px;
  }

  .practice-info__item + .practice-info__item {
    border-top: 1px solid var(--practice-accent);
  }

  .practice-info__summary {
    display: flex;
    min-height: 119px;
    align-items: center;
    gap: 16px;
    padding: 24px;
    background: var(--practice-cream);
    cursor: pointer;
    list-style: none;
  }

  .practice-info__summary::-webkit-details-marker {
    display: none;
  }

  .practice-info__name {
    display: flex;
    min-height: 70px;
    align-items: center;
    gap: 16px;
  }

  .practice-info__name--short {
    min-height: 83px;
  }

  .practice-info__num {
    flex: none;
    color: var(--practice-olive);
    font-family: var(--font-script);
    font-size: 55px;
    line-height: 1;
  }

  .practice-info__divider {
    flex: none;
    width: 1px;
    height: 70px;
    background: var(--practice-accent);
  }

  .practice-info__heading {
    color: var(--practice-text);
    font-family: var(--font-display);
    font-size: 35px;
    font-weight: 300;
    line-height: 1.18;
  }

  .practice-info__heading-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .practice-info__subheading {
    color: var(--practice-text);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 34px;
  }

  .practice-info__chevron {
    flex: none;
    width: 12px;
    height: 15px;
    margin-left: auto;
    transform: rotate(180deg);
  }

  .practice-info__item[open] .practice-info__chevron {
    transform: rotate(0);
  }

  .practice-info__panel {
    padding: 24px;
    background: var(--practice-paper);
  }

  .practice-info__points {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-left: 16px;
    color: var(--practice-text);
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 34px;
    list-style: disc;
  }

  .practice-info__draft {
    color: var(--practice-muted);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 26px;
  }

  @media (max-width: 1100px) {
    .practice-info {
      padding: 48px 0;
    }

    .practice-info__inner {
      width: calc(100% - 80px);
    }

    .practice-info__title {
      font-size: 48px;
    }

    .practice-info__intro {
      font-size: 18px;
      line-height: 30px;
    }

    .practice-info__accordion {
      margin-top: 32px;
    }

    .practice-info__summary {
      padding: 20px;
    }

    .practice-info__heading {
      font-size: 28px;
    }

    .practice-info__num {
      font-size: 44px;
    }

    .practice-info__divider {
      height: 56px;
    }

    .practice-info__points {
      font-size: 18px;
      line-height: 30px;
    }
  }

  @media (max-width: 700px) {
    .practice-info {
      padding: 40px 0;
    }

    .practice-info__inner {
      width: calc(100% - 32px);
    }

    .practice-info__head {
      gap: 12px;
      padding: 8px 0;
    }

    .practice-info__title {
      font-size: 34px;
    }

    .practice-info__intro {
      font-size: 16px;
      line-height: 26px;
    }

    .practice-info__accordion {
      margin-top: 24px;
    }

    .practice-info__summary {
      min-height: 0;
      gap: 10px;
      padding: 16px;
    }

    .practice-info__name,
    .practice-info__name--short {
      min-height: 0;
      gap: 10px;
    }

    .practice-info__num {
      font-size: 38px;
    }

    .practice-info__divider {
      height: 44px;
    }

    .practice-info__heading {
      font-size: 22px;
      line-height: 1.2;
    }

    .practice-info__subheading {
      font-size: 13px;
      line-height: 20px;
    }

    .practice-info__panel {
      padding: 16px;
    }

    .practice-info__points {
      gap: 8px;
      padding-left: 14px;
      font-size: 15px;
      line-height: 25px;
    }
  }
</style>
