---
import PracticeSectionHead from './PracticeSectionHead.astro';
import PracticeCardFree from './PracticeCardFree.astro';
import { freePractices } from '../data/practice';

const cards = freePractices.filter((item) => !item.draft);
---

<section class="practice-free" id="free" aria-labelledby="free-title" data-figma-node="410:1122">
  <div class="practice-free__inner">
    <PracticeSectionHead
      id="free-title"
      title="Практики для мягкого входа"
      subtitle="Для бережной самостоятельной настройки состояния."
      class="practice-free__head"
    />

    <div class="practice-free__slider">
      <button class="practice-free__arrow practice-free__arrow--prev" type="button" aria-label="Предыдущие практики" data-practice-prev>
        <img src="/icons/practice-slider-arrow.svg" alt="" width="48" height="48" />
      </button>

      <ul class="practice-free__track" data-practice-track>
        {cards.map((item) => <PracticeCardFree item={item} />)}
      </ul>

      <button class="practice-free__arrow practice-free__arrow--next" type="button" aria-label="Следующие практики" data-practice-next>
        <img src="/icons/practice-slider-arrow.svg" alt="" width="48" height="48" />
      </button>
    </div>

    <div class="practice-free__dots" aria-label="Практики для мягкого входа">
      {cards.map((item, index) => (
        <button
          class:list={['practice-free__dot', { 'is-active': index === 0 }]}
          type="button"
          aria-current={index === 0 ? 'true' : undefined}
          aria-label={item.title.replace(/\n/g, ' ')}
          data-practice-dot={index}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .practice-free {
    padding: 96px 0;
    background: var(--practice-cream);
  }

  .practice-free__inner {
    width: min(1280px, calc(100% - 160px));
    margin: 0 auto;
  }

  .practice-free__slider {
    position: relative;
    margin-top: 64px;
  }

  .practice-free__track {
    display: flex;
    gap: 32px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .practice-free__track::-webkit-scrollbar {
    display: none;
  }

  .practice-free__track > :global(li) {
    scroll-snap-align: start;
  }

  .practice-free__arrow {
    position: absolute;
    top: 128px;
    z-index: 2;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    transform: translateY(-50%);
  }

  .practice-free__arrow img {
    width: 48px;
    height: 48px;
  }

  .practice-free__arrow--prev {
    left: -24px;
    transform: translateY(-50%) scaleX(-1);
  }

  .practice-free__arrow--next {
    right: -24px;
  }

  .practice-free__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 24px;
  }

  .practice-free__dot {
    width: 8px;
    height: 2px;
    border-radius: 1px;
    background: var(--practice-accent);
    opacity: 0.35;
  }

  .practice-free__dot.is-active {
    opacity: 1;
  }

  @media (max-width: 1199px) {
    .practice-free {
      padding: 64px 0;
    }

    .practice-free__inner {
      width: calc(100% - 80px);
    }

    .practice-free__slider {
      margin-top: 40px;
    }

    .practice-free__arrow {
      display: none;
    }

    .practice-free__track {
      gap: 24px;
    }
  }

  @media (max-width: 767px) {
    .practice-free {
      padding: 48px 0;
    }

    .practice-free__inner {
      width: calc(100% - 32px);
    }

    .practice-free__slider {
      margin-top: 32px;
    }

    .practice-free__track {
      gap: 16px;
    }

    .practice-free__dots {
      margin-top: 20px;
    }
  }
</style>
