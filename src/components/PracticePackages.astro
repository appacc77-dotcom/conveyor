---
import PracticeSectionHead from './PracticeSectionHead.astro';
import PracticePackageCard from './PracticePackageCard.astro';
import { practicePackages } from '../data/practice';
---

<section class="practice-packages" id="packages" aria-labelledby="packages-title" data-figma-node="414:2107">
  <div class="practice-packages__inner">
    <PracticeSectionHead
      id="packages-title"
      title="Пакеты"
      subtitle="Тщательно подобранные варианты доступа к практикам и состояниям, чтобы вы могли выбрать свой ритм и глубину."
    />
    <ul class="practice-packages__grid">
      {practicePackages.map((item, index) => (
        <PracticePackageCard item={item} index={index} />
      ))}
    </ul>
  </div>
</section>

<style>
  .practice-packages {
    padding: 64px 0 128px;
    background-color: var(--practice-cream);
    background-image: url('/img/practice-packages-bg.png');
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }

  .practice-packages__inner {
    width: min(1280px, calc(100% - 160px));
    margin: 0 auto;
  }

  .practice-packages__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 32px;
    margin-top: 64px;
  }

  @media (max-width: 1199px) {
    .practice-packages {
      padding: 48px 0 64px;
    }

    .practice-packages__inner {
      width: calc(100% - 80px);
    }

    .practice-packages__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      margin-top: 40px;
    }
  }

  @media (max-width: 767px) {
    .practice-packages {
      padding: 40px 0 48px;
    }

    .practice-packages__inner {
      width: calc(100% - 32px);
    }

    .practice-packages__grid {
      gap: 20px;
      margin-top: 32px;
    }
  }
</style>
