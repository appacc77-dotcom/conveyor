---
import PracticeSectionHead from './PracticeSectionHead.astro';
import PracticeCardPay from './PracticeCardPay.astro';
import { paidPractices } from '../data/practice';
---

<section class="practice-pay" id="paid" aria-labelledby="paid-title" data-figma-node="410:1414">
  <div class="practice-pay__inner">
    <PracticeSectionHead
      id="paid-title"
      title="Практики для глубокой работы"
      subtitle="Для более глубокой самостоятельной работы с тем состоянием, которое сильнее всего влияет на жизнь сейчас."
    />
    <ul class="practice-pay__grid">
      {paidPractices.map((item) => <PracticeCardPay item={item} />)}
    </ul>
  </div>
</section>

<style>
  .practice-pay {
    padding: 96px 0 0;
    background: var(--practice-cream);
  }

  .practice-pay__inner {
    width: min(1280px, calc(100% - 160px));
    margin: 0 auto;
  }

  .practice-pay__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px 32px;
    margin-top: 64px;
  }

  @media (max-width: 1199px) {
    .practice-pay {
      padding: 64px 0;
    }

    .practice-pay__inner {
      width: calc(100% - 80px);
    }

    .practice-pay__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      margin-top: 40px;
    }
  }

  @media (max-width: 767px) {
    .practice-pay {
      padding: 48px 0;
    }

    .practice-pay__inner {
      width: calc(100% - 32px);
    }

    .practice-pay__grid {
      gap: 24px;
      margin-top: 32px;
    }
  }
</style>
