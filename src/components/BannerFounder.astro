---
---

<section class="banner" aria-label="Слова основателя" data-figma-node="79:114">
  <img
    class="banner__image"
    src="/img/banner-founder.jpg"
    alt="Екатерина Лебедева сидит у тёплой глиняной стены в солнечный день"
    width="1280"
    height="720"
    loading="eager"
  />

  <div class="banner__content">
    <p class="banner__title">Перемены в жизни начинаются изнутри</p>
    <p class="banner__signature">by Ekaterina Lebedeva</p>
  </div>
</section>

<style>
  .banner {
    position: relative;
    height: 525px;
    overflow: hidden;
    color: var(--color-white);
    background: #3a3323;
  }

  .banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 20%;
  }

  .banner__content {
    position: absolute;
    top: 165px;
    left: 80px;
    width: 642px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .banner__title {
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 300;
    line-height: 60px;
  }

  .banner__signature {
    align-self: flex-end;
    color: var(--color-white);
    font-family: var(--font-signature);
    font-size: 42px;
    font-weight: 400;
    line-height: 59px;
    letter-spacing: 2.1px;
  }

  @media (max-width: 1100px) {
    .banner__content {
      top: 140px;
      left: 40px;
      width: 560px;
    }

    .banner__title {
      font-size: 42px;
      line-height: 52px;
    }

    .banner__signature {
      font-size: 36px;
      line-height: 48px;
    }
  }

  @media (max-width: 700px) {
    .banner {
      height: auto;
      min-height: 480px;
    }

    .banner__content {
      position: relative;
      z-index: 1;
      top: auto;
      left: auto;
      width: auto;
      padding: 120px 24px 64px;
      gap: 12px;
    }

    .banner__title {
      font-size: 34px;
      line-height: 42px;
    }

    .banner__signature {
      font-size: 30px;
      line-height: 40px;
      letter-spacing: 1.5px;
    }
  }
</style>
