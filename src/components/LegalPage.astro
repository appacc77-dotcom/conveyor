---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import Footer from './Footer.astro';
import TextLink from './TextLink.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={`${title} — Syntonia`} description={description}>
  <SiteHeader />
  <main class="legal" id="main">
    <div class="legal__inner">
      <p class="legal__eyebrow">Правовая информация</p>
      <h1 class="legal__title">{title}</h1>
      <p class="legal__text" data-draft>
        Текст документа готовится и будет опубликован до запуска приёма оплат.
        В Figma этой страницы нет — это текстовый шаблон.
      </p>
      <TextLink href="/" label="На главную" size="s" />
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .legal {
    min-height: 70vh;
    padding: 200px 24px 96px;
    background: #fbf8f1;
  }

  .legal__inner {
    width: 760px;
    max-width: 100%;
    margin: 0 auto;
  }

  .legal__eyebrow {
    color: var(--color-accent);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .legal__title {
    margin-top: 12px;
    overflow-wrap: anywhere;
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 54px;
    font-weight: 300;
    line-height: 62px;
  }

  .legal__text {
    margin: 28px 0 32px;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 30px;
  }

  @media (max-width: 700px) {
    .legal {
      padding: 140px 16px 64px;
    }

    .legal__title {
      font-size: 36px;
      line-height: 44px;
    }

    .legal__text {
      font-size: 16px;
      line-height: 27px;
    }
  }
</style>
