---
import { bookingFormats } from '../data/booking';

const optionNodes = [
  '383:916',
  '383:950',
  '383:965',
  '383:980',
  '383:995',
];
const initial = bookingFormats[0];
---

<section
  class="booking"
  aria-labelledby="booking-formats-title"
  data-figma-node="383:761"
  data-booking
>
  <div class="booking__container">
    <div class="booking__scale" data-figma-node="383:787" aria-hidden="true">
      <span class="booking__scale-label">первый шаг</span>
      <span class="booking__scale-line"></span>
      <span class="booking__scale-label">глубокое сопровождение</span>
    </div>

    <div class="booking__layout">
      <div class="booking__formats">
        <h2 class="visually-hidden" id="booking-formats-title">
          Формат работы и заявка
        </h2>

        <fieldset class="booking__fieldset">
          <legend class="visually-hidden">Выберите формат работы</legend>
          <div class="booking__list" data-figma-node="383:882">
            {
              bookingFormats.map((format, index) => (
                <label
                  class="format-option"
                  id={index === 0 ? 'entry' : undefined}
                  data-figma-node={optionNodes[index]}
                >
                  <input
                    class="format-option__input"
                    type="radio"
                    name="format"
                    value={format.id}
                    checked={index === 0}
                    data-format-radio
                  />
                  <span class="format-option__card">
                    <span class="format-option__num" aria-hidden="true">
                      {format.number}
                    </span>
                    <span class="format-option__body">
                      <span class="format-option__title">{format.title}</span>
                      <span class="format-option__desc">
                        {format.optionDescription}
                      </span>
                      <span class="format-option__meta">
                        <span>{format.duration}</span>
                        <span class="format-option__dot" aria-hidden="true" />
                        <span>{format.price}</span>
                      </span>
                    </span>
                    <span class="format-option__check" aria-hidden="true">
                      <svg
                        width="18"
                        height="14"
                        viewBox="0 0 18 14"
                        fill="none"
                      >
                        <path
                          d="M2 7.3 6.6 12 16 2"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="booking__hint">
          <p class="booking__hint-text">
            Не уверены, какой формат выбрать?<br />
            <span>Начните с Точки входа.</span>
          </p>
          <button class="booking__hint-link" type="button" data-pick="entry">
            <span>Выбрать Точку входа</span>
            <svg
              class="booking__hint-arrow"
              width="19"
              height="19"
              viewBox="0 0 19 19"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2 9.5h14M11.4 4.4l5.1 5.1-5.1 5.1"
                stroke="currentColor"
                stroke-width="1.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </div>
      </div>

      <span class="booking__divider" aria-hidden="true"></span>

      <div class="booking__panel" id="question" data-figma-node="383:824">
        <div class="booking-details" data-figma-node="804:349">
          <p class="booking-details__label">Выбранный формат</p>
          <p class="booking-details__title">
            <span data-booking-title>{initial.title}</span>
            <span class="booking-details__dot" aria-hidden="true"></span>
            <span data-booking-duration>{initial.duration}</span>
            <span class="booking-details__dot" aria-hidden="true"></span>
            <span data-booking-price>{initial.price}</span>
          </p>

          <div class="booking-details__about">
            <p class="booking-details__label booking-details__label--about">
              О формате
            </p>
            <div class="booking-details__about-text" data-booking-about>
              {
                initial.about.map((paragraph) => (
                  <p>{paragraph}</p>
                ))
              }
            </div>
          </div>

          <div
            class="booking-details__meeting"
            data-booking-meeting
            hidden={initial.points.length === 0}
          >
            <p class="booking-details__meeting-label">На встрече:</p>
            <ul class="booking-details__points" data-booking-points>
              {
                initial.points.map((point) => (
                  <li>{point}</li>
                ))
              }
            </ul>
          </div>
        </div>

        <span class="booking__form-divider" aria-hidden="true"></span>

        <form
          class="booking-form"
          novalidate
          data-booking-form
          data-draft
          aria-describedby="booking-draft-note"
        >
          <p class="visually-hidden" id="booking-draft-note">
            Форма работает в режиме черновика: отправка заявки пока не
            подключена.
          </p>

          <input
            type="hidden"
            name="format"
            value={initial.id}
            data-booking-format-input
          />

          <div class="booking-field">
            <div class="booking-field__head">
              <label class="booking-field__label" for="booking-name">
                Имя <span class="booking-field__required" aria-hidden="true">*</span>
              </label>
            </div>
            <input
              class="booking-field__input"
              id="booking-name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder="Как к вам обращаться"
              required
              aria-describedby="booking-name-error"
            />
            <p class="booking-field__error" id="booking-name-error" hidden>
              Пожалуйста, укажите имя
            </p>
          </div>

          <div class="booking-field">
            <div class="booking-field__head">
              <label class="booking-field__label" for="booking-email">
                Email <span class="booking-field__required" aria-hidden="true">*</span>
              </label>
            </div>
            <input
              class="booking-field__input"
              id="booking-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="ваш@email.com"
              required
              aria-describedby="booking-email-error"
            />
            <p class="booking-field__error" id="booking-email-error" hidden>
              Укажите корректный email
            </p>
          </div>

          <div class="booking-field">
            <div class="booking-field__head">
              <label class="booking-field__label" for="booking-phone">
                Телефон <span class="booking-field__required" aria-hidden="true">*</span>
              </label>
            </div>
            <input
              class="booking-field__input"
              id="booking-phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              placeholder="+7 (___) ___-__-__"
              required
              aria-describedby="booking-phone-error"
            />
            <p class="booking-field__error" id="booking-phone-error" hidden>
              Укажите телефон
            </p>
          </div>

          <div class="booking-field">
            <div class="booking-field__head">
              <label class="booking-field__label" for="booking-comment">
                Комментарий
                <span class="booking-field__optional">опционально</span>
              </label>
            </div>
            <textarea
              class="booking-field__input booking-field__input--area"
              id="booking-comment"
              name="comment"
              rows="3"
              placeholder="Что важно знать заранее, ваш запрос или вопросы…"
            ></textarea>
          </div>

          <button class="booking-form__submit" type="submit">
            Отправить заявку
          </button>
          <p class="booking-form__note">
            Нажимая «Отправить заявку», вы соглашаетесь с условиями обработки
            данных.
          </p>
          <p
            class="booking-form__status"
            role="status"
            aria-live="polite"
            data-booking-status
            hidden
          ></p>

          <div class="booking-legal" data-figma-node="385:1341">
            <div class="booking-legal__head">
              <p class="booking-legal__title">Правовая информация</p>
            </div>
            <div class="booking-legal__body">
              <p class="booking-legal__text">
                Материалы и сессии носят консультативный характер и не являются
                медицинской услугой.
              </p>
              <ul class="booking-legal__links">
                <li><a href="/offer.html">Публичная оферта</a></li>
                <li>
                  <a href="/privacy.html">Политика конфиденциальности</a>
                </li>
                <li>
                  <a href="/consent.html">
                    Согласие на обработку персональных данных
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script
  type="application/json"
  id="booking-formats-data"
  set:html={JSON.stringify(bookingFormats)}
></script>

<script>
  const root = document.querySelector('[data-booking]');
  const dataNode = document.getElementById('booking-formats-data');

  if (root && dataNode) {
    let formats = [];
    try {
      formats = JSON.parse(dataNode.textContent || '[]');
    } catch {
      formats = [];
    }

    const byId = new Map(formats.map((format) => [format.id, format]));
    const radios = Array.from(
      root.querySelectorAll('[data-format-radio]'),
    );
    const titleNode = root.querySelector('[data-booking-title]');
    const durationNode = root.querySelector('[data-booking-duration]');
    const priceNode = root.querySelector('[data-booking-price]');
    const aboutNode = root.querySelector('[data-booking-about]');
    const pointsNode = root.querySelector('[data-booking-points]');
    const meetingNode = root.querySelector('[data-booking-meeting]');
    const formatInput = root.querySelector('[data-booking-format-input]');
    const form = root.querySelector('[data-booking-form]');
    const statusNode = root.querySelector('[data-booking-status]');

    const hideStatus = () => {
      if (statusNode) statusNode.hidden = true;
    };

    const renderFormat = (format) => {
      if (!format) return;
      if (titleNode) titleNode.textContent = format.title;
      if (durationNode) durationNode.textContent = format.duration;
      if (priceNode) priceNode.textContent = format.price;
      if (formatInput) formatInput.value = format.id;

      if (aboutNode) {
        aboutNode.replaceChildren(
          ...format.about.map((paragraph) => {
            const element = document.createElement('p');
            element.textContent = paragraph;
            return element;
          }),
        );
      }

      if (pointsNode && meetingNode) {
        pointsNode.replaceChildren(
          ...format.points.map((point) => {
            const element = document.createElement('li');
            element.textContent = point;
            return element;
          }),
        );
        meetingNode.hidden = format.points.length === 0;
      }

      hideStatus();
    };

    radios.forEach((radio) => {
      radio.addEventListener('change', () => {
        if (radio.checked) renderFormat(byId.get(radio.value));
      });
    });

    root.querySelectorAll('[data-pick="entry"]').forEach((button) => {
      button.addEventListener('click', () => {
        const radio = radios.find((item) => item.value === 'entry');
        if (!radio) return;
        radio.checked = true;
        renderFormat(byId.get('entry'));
        radio.focus({ preventScroll: true });
      });
    });

    const fields = [
      {
        input: form?.querySelector('#booking-name'),
        error: form?.querySelector('#booking-name-error'),
        validate: (value) => value.trim().length > 1,
      },
      {
        input: form?.querySelector('#booking-email'),
        error: form?.querySelector('#booking-email-error'),
        validate: (value) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value.trim()),
      },
      {
        input: form?.querySelector('#booking-phone'),
        error: form?.querySelector('#booking-phone-error'),
        validate: (value) => value.replace(/\D/g, '').length >= 10,
      },
    ].filter((field) => field.input && field.error);

    const setFieldError = (field, invalid) => {
      field.input.setAttribute('aria-invalid', String(invalid));
      field.error.hidden = !invalid;
      if (invalid) {
        field.input.setAttribute('aria-describedby', field.error.id);
      } else {
        field.input.removeAttribute('aria-describedby');
      }
    };

    fields.forEach((field) => {
      field.input.addEventListener('input', () => {
        setFieldError(field, false);
        hideStatus();
      });
    });

    if (form) {
      form.addEventListener('submit', (event) => {
        event.preventDefault();

        let firstInvalid = null;

        fields.forEach((field) => {
          const invalid = !field.validate(field.input.value);
          setFieldError(field, invalid);
          if (invalid && !firstInvalid) firstInvalid = field;
        });

        if (firstInvalid) {
          hideStatus();
          firstInvalid.input.focus();
          return;
        }

        if (statusNode) {
          statusNode.textContent =
            'Поля заполнены корректно. Заявка не отправлена: сервис записи пока не подключён.';
          statusNode.dataset.state = 'draft';
          statusNode.hidden = false;
        }
      });
    }
  }
</script>

<style>
  .booking {
    --booking-gutter: 80px;
    --booking-line: rgba(138, 133, 96, 0.28);
    --booking-line-strong: #8a8560;
    --booking-selected: rgba(138, 133, 96, 0.25);
    --booking-hover: rgba(138, 133, 96, 0.1);
    --booking-surface: #f4eee3;
    --booking-deep: #6b6357;
    --booking-muted: #7a756d;
    --booking-heading: #3a2214;
    padding-block: 64px;
    background: var(--color-page);
  }

  .booking__container {
    width: min(1280px, calc(100% - var(--booking-gutter) * 2));
    margin: 0 auto;
  }

  .booking__scale {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 20px;
    margin-bottom: 48px;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    line-height: 20px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .booking__scale-label {
    flex: none;
    white-space: nowrap;
  }

  .booking__scale-line {
    position: relative;
    flex: 1;
    min-width: 24px;
    height: 1px;
    background: var(--booking-line-strong);
  }

  .booking__scale-line::after {
    content: "";
    position: absolute;
    top: -3px;
    right: 0;
    width: 7px;
    height: 7px;
    border-top: 1px solid var(--booking-line-strong);
    border-right: 1px solid var(--booking-line-strong);
    transform: rotate(45deg);
  }

  .booking__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr);
    column-gap: 32px;
    align-items: start;
    min-height: 1350px;
  }

  .booking__formats,
  .booking__panel {
    min-width: 0;
  }

  .booking__fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .booking__list {
    display: grid;
    gap: 16px;
  }

  .booking__divider {
    display: block;
    width: 1px;
    height: 100%;
    background: var(--booking-line);
  }

  .format-option {
    position: relative;
    display: block;
    cursor: pointer;
    border-radius: 16px;
  }

  .format-option:not(:first-child)::before {
    content: "";
    position: absolute;
    top: -8.5px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--booking-line);
  }

  .format-option:has(input:checked)::before {
    display: none;
  }

  .format-option__input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .format-option__card {
    position: relative;
    display: flex;
    gap: 8px;
    min-height: 209px;
    padding: 32px;
    border-radius: 16px;
    transition: background-color 0.2s ease;
  }

  .format-option:hover .format-option__card {
    background: var(--booking-hover);
  }

  .format-option:has(input:checked) .format-option__card {
    background: var(--booking-selected);
  }

  .format-option:has(input:focus-visible) .format-option__card {
    outline: 2px solid #b8870a;
    outline-offset: 3px;
  }

  .format-option__num {
    flex: 0 0 60px;
    color: var(--color-olive);
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 300;
    line-height: 60px;
    font-variant-numeric: lining-nums;
  }

  .format-option__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    padding-right: 55px;
  }

  .format-option__title {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 300;
    line-height: 39px;
  }

  .format-option__desc {
    color: var(--booking-deep);
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 400;
    line-height: 27px;
  }

  .format-option__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--booking-deep);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    line-height: 20px;
  }

  .format-option__dot {
    display: block;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
  }

  .format-option__check {
    position: absolute;
    top: 50%;
    right: 32px;
    display: grid;
    width: 39px;
    height: 39px;
    place-items: center;
    border-radius: 50%;
    background: var(--color-olive);
    color: var(--color-white);
    opacity: 0;
    transform: translateY(-50%);
    transition: opacity 0.15s ease;
  }

  .format-option:has(input:checked) .format-option__check {
    opacity: 1;
  }

  .booking__hint {
    padding-block: 24px;
  }

  .booking__hint-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    line-height: 27px;
  }

  .booking__hint-text span {
    font-weight: 500;
  }

  .booking__hint-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    color: var(--color-olive);
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 400;
    line-height: 29px;
    letter-spacing: 0.03em;
    text-align: left;
  }

  .booking__hint-link::after {
    content: "";
    position: absolute;
    inset: -8px -4px;
    border-radius: 4px;
  }

  .booking__hint-link:hover span {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .booking__hint-arrow {
    flex: none;
    width: 19px;
    height: 19px;
  }

  .booking__form-divider {
    display: block;
    height: 1px;
    margin: 24px 0;
    background: var(--booking-line);
  }

  .booking-details {
    display: flex;
    flex-direction: column;
    min-height: 487px;
  }

  .booking-details__label {
    color: var(--booking-deep);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    line-height: 30px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .booking-details__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    color: var(--booking-heading);
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 300;
    line-height: 39px;
  }

  .booking-details__dot {
    display: block;
    width: 5px;
    height: 5px;
    flex: none;
    border-radius: 50%;
    background: currentColor;
  }

  .booking-details__about {
    margin-top: 24px;
  }

  .booking-details__label--about {
    color: var(--booking-muted);
    font-size: 13px;
    line-height: 23px;
  }

  .booking-details__about-text {
    margin-top: 8px;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    line-height: 27px;
  }

  .booking-details__about-text p + p {
    margin-top: 8px;
  }

  .booking-details__meeting {
    margin-top: 24px;
  }

  .booking-details__meeting[hidden] {
    display: none;
  }

  .booking-details__meeting-label {
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    line-height: 27px;
  }

  .booking-details__points {
    margin-top: 8px;
    padding-left: 22px;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    line-height: 34px;
    list-style: disc;
  }

  .booking-details__points li::marker {
    color: var(--color-text);
  }

  .booking-form {
    display: block;
  }

  .booking-field + .booking-field {
    margin-top: 24px;
  }

  .booking-field__head {
    display: flex;
    align-items: baseline;
    gap: 6px;
    min-height: 20px;
  }

  .booking-field__label {
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    line-height: 20px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .booking-field__required {
    color: var(--booking-heading);
  }

  .booking-field__optional {
    margin-left: 6px;
    color: var(--booking-muted);
    font-size: 13px;
    line-height: 20px;
    letter-spacing: 0.16em;
  }

  .booking-field__input {
    display: block;
    width: 100%;
    height: 54px;
    margin-top: 16px;
    padding: 0 16px;
    border: 1px solid var(--booking-line-strong);
    border-radius: 4px;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    line-height: 20px;
  }

  .booking-field__input::placeholder {
    color: var(--booking-muted);
    opacity: 1;
  }

