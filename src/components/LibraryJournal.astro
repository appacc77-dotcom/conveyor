---
---

<section
  class="library-journal"
  aria-labelledby="journal-title"
  data-figma-node="272:1017"
>
  <div class="library-journal__inner">
    <div class="library-journal__content">
      <p class="library-journal__eyebrow">журнал</p>
      <h2 class="library-journal__title" id="journal-title">Syntonia.Life</h2>
      <p class="library-journal__text">
        Выпуски, собранные вокруг того, что действительно волнует и&nbsp;сопровождает
        жизнь: внутренние состояния, отношения, выбор, опора, перемены, практика
        и&nbsp;смысл.
      </p>
    </div>

    <div class="library-journal__media">
      <img
        class="library-journal__image"
        src="/img/journal-latest.jpg"
        alt=""
        width="2752"
        height="1536"
        loading="lazy"
      />

      <article class="journal-latest" aria-label="Актуальный выпуск журнала">
        <p class="journal-latest__label">актуальный выпуск</p>
        <p class="journal-latest__name">
          <span class="journal-latest__num">№02</span>
          <span>Тело и&nbsp;состояние</span>
        </p>
        <a class="journal-latest__btn" href="#" data-draft>
          <span>читать выпуск</span>
          <img
            class="journal-latest__arrow"
            src="/icons/icon-arrow.svg"
            alt=""
            width="14"
            height="14"
          />
        </a>
      </article>
    </div>
  </div>
</section>

<style>
  .library-journal {
    padding-block: 56px;
    background: var(--library-dark);
  }

  .library-journal__inner {
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 24px;
    display: grid;
    gap: 32px;
  }

  .library-journal__content {
    min-width: 0;
  }

  .library-journal__eyebrow {
    color: var(--color-accent);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .library-journal__title {
    margin-top: 24px;
    color: var(--library-sand);
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 300;
    line-height: 1.25;
  }

  .library-journal__text {
    margin-top: 24px;
    color: var(--library-cream);
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 400;
    line-height: 28px;
  }

  .library-journal__media {
    position: relative;
    min-height: 260px;
    overflow: hidden;
    border-radius: 12px;
  }

  .library-journal__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 22% 53%;
  }

  .journal-latest {
    position: absolute;
    left: 16px;
    bottom: 16px;
    width: 217px;
    height: 115px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-radius: 4px;
    background: var(--color-page);
  }

  .journal-latest__label {
    color: var(--color-accent);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 400;
    line-height: 20px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .journal-latest__name {
    display: flex;
    gap: 4px;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 300;
    line-height: 20px;
    white-space: nowrap;
  }

  .journal-latest__num {
    flex: none;
  }

  .journal-latest__btn {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 27px;
    padding: 4px 8px;
    border-radius: 2px;
    background-color: var(--color-olive);
    background-image: url('/img/btn-texture.jpg');
    background-size: cover;
    background-position: center;
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 400;
    line-height: 19px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .journal-latest__arrow {
    flex: none;
    width: 14px;
    height: 14px;
  }

  @media (min-width: 768px) {
    .library-journal {
      padding-block: 64px;
    }

    .library-journal__inner {
      padding-inline: 32px;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: center;
      gap: 32px;
    }

    .library-journal__media {
      min-height: 0;
      height: 340px;
    }

    .library-journal__eyebrow {
      font-size: 17px;
    }

    .library-journal__title {
      margin-top: 28px;
      font-size: 36px;
      line-height: 1.2;
    }

    .library-journal__text {
      margin-top: 28px;
    }
  }

  @media (min-width: 1200px) {
    .library-journal {
      padding-block: 64px;
    }

    .library-journal__inner {
      padding-inline: 80px;
      grid-template-columns: 493px 723px;
      align-items: start;
      gap: 64px;
    }

    .library-journal__media {
      height: 442px;
    }

    /* Узел eyebrow: 20/30, трекинг 3.2 px. */
    .library-journal__eyebrow {
      font-size: 20px;
      line-height: 30px;
      letter-spacing: 3.2px;
    }

    /* Заголовок 48/60 через 32 px, описание 20/34 через 32 px. */
    .library-journal__title {
      margin-top: 32px;
      font-size: 48px;
      line-height: 60px;
    }

    .library-journal__text {
      margin-top: 32px;
      font-size: 20px;
      line-height: 34px;
    }
  }
</style>
