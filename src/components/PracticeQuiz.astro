---
import Button from './Button.astro';
---

<section class="practice-quiz" id="quiz" aria-labelledby="practice-quiz-title" data-figma-node="410:1365">
  <img
    class="practice-quiz__bg"
    src="/img/practice-quiz-banner.jpg"
    alt=""
    width="1280"
    height="548"
    loading="lazy"
  />
  <div class="practice-quiz__content">
    <div class="practice-quiz__description">
      <h2 class="practice-quiz__title" id="practice-quiz-title">Не знаешь, с чего начать?</h2>
      <p class="practice-quiz__text">
        Пройди короткий тест и узнай свой код — состояние, которое сильнее<br />
        всего влияет на твою жизнь сейчас.
      </p>
    </div>

    <div class="practice-quiz__action">
      <p class="practice-quiz__gift">
        <span class="practice-quiz__gift-script">Практика</span> по твоему коду — в подарок.
      </p>
      <div class="practice-quiz__row">
        <Button href="/quiz.html" label="Пройти тест" variant="solid" />
        <p class="practice-quiz__meta">
          <span>Бесплатно</span>
          <span class="practice-quiz__dot" aria-hidden="true"></span>
          <span>2-3 минуты</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .practice-quiz {
    position: relative;
    height: 550px;
    overflow: hidden;
    color: var(--color-white);
  }

  .practice-quiz__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .practice-quiz__content {
    position: absolute;
    top: 126px;
    left: 128px;
    display: flex;
    width: 701px;
    max-width: calc(100% - 256px);
    flex-direction: column;
    gap: 32px;
  }

  .practice-quiz__description {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .practice-quiz__title {
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 300;
    line-height: 60px;
  }

  .practice-quiz__text {
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    line-height: 34px;
  }

  .practice-quiz__action {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .practice-quiz__gift {
    display: flex;
    min-height: 61px;
    align-items: center;
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    line-height: 34px;
  }

  .practice-quiz__gift-script {
    margin-right: 4px;
    font-family: var(--font-script);
    font-size: 32px;
    line-height: 1;
  }

  .practice-quiz__row {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .practice-quiz__meta {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    line-height: 20px;
  }

  .practice-quiz__dot {
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: currentColor;
  }

  @media (max-width: 1100px) {
    .practice-quiz {
      height: auto;
      min-height: 500px;
    }

    .practice-quiz__content {
      position: relative;
      top: auto;
      left: auto;
      width: auto;
      max-width: 640px;
      padding: 72px 40px;
      gap: 28px;
    }

    .practice-quiz__title {
      font-size: 40px;
      line-height: 48px;
    }

    .practice-quiz__bg {
      object-position: 60% 50%;
    }
  }

  @media (max-width: 700px) {
    .practice-quiz {
      min-height: 0;
    }

    .practice-quiz__content {
      max-width: none;
      padding: 48px 20px 52px;
      gap: 24px;
    }

    .practice-quiz__title {
      font-size: 32px;
      line-height: 38px;
    }

    .practice-quiz__text {
      font-size: 16px;
      line-height: 26px;
    }

    .practice-quiz__text br {
      display: none;
    }

    .practice-quiz__gift {
      min-height: 0;
      font-size: 17px;
      line-height: 26px;
    }

    .practice-quiz__gift-script {
      font-size: 26px;
    }

    .practice-quiz__row {
      flex-wrap: wrap;
      gap: 14px 20px;
    }
  }
</style>
