---
interface Props {
  href: string;
  label: string;
  size?: 's' | 'm' | 'l';
  arrow?: boolean;
  class?: string;
}

const { href, label, size = 'm', arrow = true, class: className } = Astro.props;
---

<a class:list={['text-link', `text-link--${size}`, className]} href={href}>
  <span>{label}</span>
  {
    arrow && (
      <img
        class="text-link__arrow"
        src="/icons/icon-arrow.svg"
        alt=""
        width="19"
        height="19"
      />
    )
  }
</a>

<style>
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    color: var(--color-olive);
    font-family: var(--font-body);
    font-weight: 400;
    letter-spacing: 0.03em;
    border-bottom: 1px solid currentColor;
  }

  .text-link--s {
    font-size: 18px;
    line-height: 29px;
  }

  .text-link--m {
    font-size: 24px;
    line-height: 40px;
  }

  .text-link--l {
    font-size: 28px;
    line-height: 46px;
  }

  .text-link__arrow {
    flex: none;
    width: 19px;
    height: 19px;
    margin-top: 1px;
  }

  .text-link:hover {
    opacity: 0.8;
  }

  @media (max-width: 700px) {
    .text-link--s {
      font-size: 17px;
      line-height: 28px;
    }

    .text-link--m {
      font-size: 20px;
      line-height: 32px;
    }

    .text-link--l {
      font-size: 20px;
      line-height: 32px;
    }

    .text-link__arrow {
      width: 16px;
      height: 16px;
    }
  }
</style>
