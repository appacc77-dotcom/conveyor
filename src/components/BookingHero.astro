---
---

<section
  class="booking-hero"
  aria-labelledby="booking-title"
  data-figma-node="383:287"
>
  <img
    class="booking-hero__bg"
    src="/img/booking-hero-figma.jpg"
    alt="Каменная дорожка в саду с оливой в тёплом свете"
    width="1400"
    height="788"
    fetchpriority="high"
  />
  <span class="booking-hero__shade" aria-hidden="true"></span>

  <div class="booking-hero__inner">
    <div class="booking-hero__content" data-figma-node="383:756">
      <h1 class="booking-hero__title" id="booking-title" data-figma-node="383:757">
        Форматы работы
      </h1>
      <p class="booking-hero__lead" data-figma-node="383:758">
        Форматы различаются по глубине запроса, длительности и степени
        сопровождения.
      </p>
    </div>
  </div>
</section>

<style>
  .booking-hero {
    --hero-gutter: 80px;
    --hero-content-top: 281px;
    position: relative;
    height: 509px;
    overflow: hidden;
    background: #3a3323;
    color: var(--color-white);
  }

  .booking-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 34%;
  }

  .booking-hero__shade {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.12);
  }

  .booking-hero__inner {
    position: relative;
    z-index: 1;
    width: min(1280px, calc(100% - var(--hero-gutter) * 2));
    margin: 0 auto;
  }

  .booking-hero__content {
    width: 550px;
    max-width: 100%;
    padding-top: var(--hero-content-top);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .booking-hero__title {
    color: var(--color-white);
    font-family: var(--font-hero);
    font-size: 64px;
    font-weight: 300;
    line-height: 64px;
  }

  .booking-hero__lead {
    max-width: 550px;
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    line-height: 34px;
  }

  @media (max-width: 1200px) {
    .booking-hero {
      --hero-gutter: 48px;
      --hero-content-top: 220px;
      height: 470px;
    }

    .booking-hero__content {
      gap: 24px;
    }

    .booking-hero__title {
      font-size: 56px;
      line-height: 56px;
    }

    .booking-hero__lead {
      font-size: 18px;
      line-height: 30px;
    }
  }

  @media (max-width: 700px) {
    .booking-hero {
      --hero-gutter: 20px;
      --hero-content-top: 196px;
      height: 440px;
    }

    .booking-hero__content {
      gap: 20px;
    }

    .booking-hero__title {
      font-size: 44px;
      line-height: 46px;
    }

    .booking-hero__lead {
      max-width: 340px;
      font-size: 17px;
      line-height: 28px;
    }
  }
</style>
