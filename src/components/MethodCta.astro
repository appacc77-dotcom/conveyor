---
import Button from './Button.astro';
---

<section class="method-cta" aria-labelledby="method-cta-title" data-figma-node="334:992">
  <img
    class="method-cta__bg"
    src="/img/method-cta.jpg"
    alt=""
    width="1560"
    height="542"
    loading="lazy"
  />

  <div class="method-cta__inner">
    <div class="method-cta__body">
      <h2 class="method-cta__title" id="method-cta-title">
        Глубинные изменения начинаются с одного шага
      </h2>
      <p class="method-cta__text">
        Выберите точку входа, которая подходит вам прямо сейчас, и начните путь
        к ясности, внутренней опоре и подлинной жизни.
      </p>
      <div class="method-cta__actions">
        <Button
          href="/booking.html#entry"
          label="Начать с точки входа"
          variant="textured"
          arrow={false}
        />
        <Button
          href="/booking.html#question"
          label="Задать вопрос"
          variant="outline"
          arrow={false}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .method-cta {
    position: relative;
    height: 499px;
    padding: 96px 24px;
    overflow: hidden;
  }

  .method-cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .method-cta__inner {
    position: relative;
    z-index: 1;
    width: 1280px;
    max-width: 100%;
    height: 307px;
    margin: 0 auto;
    padding-left: 64px;
    display: flex;
    align-items: center;
  }

  .method-cta__body {
    width: 491px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .method-cta__title {
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 38px;
    font-weight: 300;
    line-height: 48px;
  }

  .method-cta__text {
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    line-height: 34px;
  }

  .method-cta__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @media (max-width: 1100px) {
    .method-cta {
      height: auto;
      padding: 64px 24px;
    }

    .method-cta__inner {
      height: auto;
      padding-left: 0;
    }

    .method-cta__body {
      width: min(560px, 100%);
      padding: 32px;
      border-radius: 16px;
      background: rgba(251, 248, 241, 0.85);
    }
  }

  @media (max-width: 700px) {
    .method-cta {
      padding: 56px 16px;
    }

    .method-cta__body {
      padding: 24px;
    }

    .method-cta__title {
      font-size: 30px;
      line-height: 38px;
    }

    .method-cta__text {
      font-size: 17px;
      line-height: 28px;
    }

    .method-cta__actions {
      flex-wrap: wrap;
    }
  }
</style>
