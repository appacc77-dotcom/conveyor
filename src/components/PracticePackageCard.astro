---
import type { PracticePackageData } from '../data/practice';

interface Props {
  item: PracticePackageData;
  index: number;
}

const { item, index } = Astro.props;
const titleLines = item.title.split('\n');
const headGap = index === 2 ? 32 : 24;
---

<li
  class:list={['practice-package-card', `practice-package-card--${index + 1}`]}
  data-figma-node={item.figmaNode}
  style={`--card-height: ${item.cardHeight}px; --head-height: ${item.titleHeight}px; --list-height: ${item.listHeight}px; --head-gap: ${headGap}px`}
>
  <div class="practice-package-card__head">
    <h3 class="practice-package-card__title">
      {titleLines.map((line, lineIndex) => (
        <>
          {lineIndex > 0 && <br />}
          {line}
        </>
      ))}
    </h3>
    <p class="practice-package-card__text">{item.text}</p>
  </div>

  <span class="practice-package-card__divider" aria-hidden="true"></span>

  <div class="practice-package-card__count">
    <img class="practice-package-card__count-icon" src="/icons/practice-list.svg" alt="" width="22" height="20" />
    <span>{item.count}</span>
    <img class="practice-package-card__chevron" src="/icons/practice-chevron-up.svg" alt="" width="12" height="15" />
  </div>

  <ul class="practice-package-card__list">
    {item.points.map((point) => <li>{point}</li>)}
  </ul>

  <span class="practice-package-card__divider" aria-hidden="true"></span>

  <p class="practice-package-card__access">{item.access}</p>

  <p class="practice-package-card__price">
    <span class="practice-package-card__current">{item.price}</span>
    <span class="practice-package-card__old">вместо {item.oldPrice}</span>
  </p>

  <button
    class="practice-package-card__buy"
    type="button"
    aria-label={`Открыть пространство: ${item.title.replace(/\n/g, ' ')}`}
    data-practice-buy
  >
    Открыть пространство
    <img src="/icons/icon-arrow.svg" alt="" width="14" height="14" />
  </button>
</li>

<style>
  .practice-package-card {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-height: var(--card-height, 818px);
    padding: 32px;
    border-radius: 16px;
    color: var(--practice-text);
    background: var(--practice-paper);
  }

  .practice-package-card--2 {
    background: linear-gradient(180deg, var(--practice-paper) 0%, var(--practice-package-2-end) 100%);
  }

  .practice-package-card--3 {
    background: linear-gradient(180deg, var(--practice-package-3-start) 0%, var(--practice-package-3-end) 100%);
  }

  .practice-package-card__head {
    display: flex;
    min-height: var(--head-height, 150px);
    flex-direction: column;
    gap: var(--head-gap, 24px);
  }

  .practice-package-card__title {
    color: var(--practice-heading);
    font-family: var(--font-display);
    font-size: 33px;
    font-weight: 400;
    line-height: 39px;
  }

  .practice-package-card__text {
    color: var(--practice-text);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
  }

  .practice-package-card__divider {
    display: block;
    height: 1px;
    background: var(--practice-line);
  }

  .practice-package-card__count {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 34px;
    color: var(--practice-text);
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 34px;
  }

  .practice-package-card__count-icon {
    flex: none;
    width: 22px;
    height: 20px;
  }

  .practice-package-card__chevron {
    flex: none;
    width: 12px;
    height: 15px;
    margin-left: auto;
  }

  .practice-package-card__list {
    min-height: var(--list-height, 248px);
    padding-left: 16px;
    color: var(--practice-text);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    line-height: 20px;
    list-style: disc;
  }

  .practice-package-card__list li + li {
    margin-top: 8px;
  }

  .practice-package-card__list li::marker {
    color: var(--practice-text);
  }

  .practice-package-card__access {
    color: var(--practice-text);
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 34px;
  }

  .practice-package-card__price {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 57px;
    color: var(--practice-heading);
    font-family: var(--font-display);
  }

  .practice-package-card__current {
    font-size: 48px;
    font-weight: 300;
    line-height: 1.19;
  }

  .practice-package-card__old {
    color: var(--practice-text);
    font-size: 29px;
    font-weight: 300;
    line-height: 1.34;
    white-space: nowrap;
  }

  .practice-package-card__buy {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 61px;
    padding: 0 24px;
    border-radius: 4px;
    background-color: var(--practice-olive);
    background-image: url('/img/btn-texture.jpg');
    background-position: center;
    background-size: cover;
    color: var(--practice-button-text);
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 400;
    line-height: 29px;
    letter-spacing: 0.03em;
  }

  .practice-package-card__buy img {
    flex: none;
    width: 14px;
    height: 14px;
  }

  .practice-package-card__buy:hover {
    opacity: 0.92;
  }

  @media (max-width: 1199px) {
    .practice-package-card {
      min-height: 0;
    }

    .practice-package-card__head,
    .practice-package-card__list {
      min-height: 0;
    }
  }

  @media (max-width: 700px) {
    .practice-package-card {
      gap: 20px;
      padding: 24px 20px;
    }

    .practice-package-card__head {
      gap: 16px;
    }

    .practice-package-card__title {
      font-size: 27px;
      line-height: 32px;
    }

    .practice-package-card__text {
      font-size: 15px;
      line-height: 23px;
    }

    .practice-package-card__count {
      font-size: 17px;
      line-height: 28px;
    }

    .practice-package-card__access {
      font-size: 16px;
      line-height: 26px;
    }

    .practice-package-card__price {
      gap: 14px;
      min-height: 0;
    }

    .practice-package-card__current {
      font-size: 38px;
    }

    .practice-package-card__old {
      font-size: 20px;
    }

    .practice-package-card__buy {
      height: 52px;
      font-size: 16px;
    }
  }
</style>
