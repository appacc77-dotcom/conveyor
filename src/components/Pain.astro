---
import Button from './Button.astro';

const items = [
  "Если жизнь идёт, а всё будто стоит на месте",
  "Если попыток было уже столько, а по-настоящему легче так и не стало",
  "Если ты устаёшь носить в себе напряжение, тяжесть или скрытую боль",
  "Если тебе нужна глубокая и точная внутренняя работа",
];
---

<section class="pain" aria-labelledby="pain-title" data-figma-node="79:116">
  <img
    class="pain__bg"
    src="/img/pain.jpg"
    alt=""
    width="1280"
    height="720"
    loading="lazy"
  />

  <div class="pain__inner">
    <div class="pain__intro">
      <h2 class="pain__title" id="pain-title">
        Когда нужен не просто разговор, а реальные перемены в жизни
      </h2>
      <p class="pain__lead">
        Если в отношениях снова больно, в выборе нет опоры, внутри тяжело,
        а энергии всё меньше — причина внутри, и это можно изменить
      </p>
      <div class="pain__action">
        <span class="pain__script" aria-hidden="true">Начни</span>
        <Button
          href="/booking.html#entry"
          label="с точки входа"
          variant="textured"
          size="l"
          caps
          class="btn--pain"
        />
      </div>
    </div>

    <ol class="pain__list">
      {
        items.map((text, index) => (
          <li class="pain__item">
            <div class="pain__row">
              <span class="pain__num" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <p class="pain__text">{text}</p>
            </div>
            <span class="pain__divider" aria-hidden="true" />
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .pain {
    position: relative;
    height: 707px;
    overflow: hidden;
    background: var(--color-page);
  }

  .pain__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .pain__inner {
    position: relative;
    width: 1280px;
    max-width: 100%;
    height: 100%;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 584px 584px;
    gap: 64px;
    align-items: center;
  }

  .pain__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    width: 584px;
  }

  .pain__title {
    max-width: 539px;
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 300;
    line-height: 60px;
  }

  .pain__lead {
    max-width: 473px;
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    line-height: 34px;
  }

  .pain__action {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 71px;
  }

  .pain__script {
    flex: none;
    color: var(--color-text);
    font-family: var(--font-script);
    font-size: 42px;
    font-weight: 400;
    line-height: 71px;
    letter-spacing: 1.26px;
  }

  .pain__list {
    width: 584px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .pain__item {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .pain__row {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 78px;
  }

  .pain__num {
    flex: none;
    color: var(--color-accent);
    font-family: var(--font-script);
    font-size: 55px;
    font-weight: 400;
    line-height: 69px;
  }

  .pain__text {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 29px;
    font-weight: 300;
    line-height: 39px;
  }

  .pain__divider {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--color-accent);
  }

  @media (max-width: 1100px) {
    .pain {
      height: auto;
    }

    .pain__inner {
      width: 100%;
      max-width: 760px;
      grid-template-columns: 1fr;
      gap: 48px;
      padding: 72px 24px;
    }

    .pain__intro,
    .pain__list {
      width: 100%;
    }

    .pain__title,
    .pain__lead {
      max-width: 100%;
    }
  }

  @media (max-width: 700px) {
    .pain__inner {
      gap: 40px;
      padding: 64px 24px;
    }

    .pain__intro {
      gap: 20px;
    }

    .pain__title {
      font-size: 34px;
      line-height: 42px;
    }

    .pain__lead {
      font-size: 17px;
      line-height: 28px;
    }

    .pain__action {
      flex-wrap: wrap;
      gap: 16px 20px;
    }

    .pain__script {
      font-size: 32px;
      line-height: 52px;
    }

    .pain__list {
      gap: 26px;
    }

    .pain__row {
      gap: 16px;
      min-height: 0;
    }

    .pain__num {
      font-size: 40px;
      line-height: 48px;
    }

    .pain__text {
      font-size: 20px;
      line-height: 28px;
    }
  }
</style>
